---
import { t } from '../i18n/ui';

interface Props {
  page: {
    currentPage: number;
    lastPage: number;
    url: {
      prev: string | undefined;
      next: string | undefined;
      current: string;
    };
  };
  locale: 'ko' | 'en';
}

const { page, locale } = Astro.props;
const showPagination = page.lastPage > 1;
// Truncate to first/last/±1 with ellipses beyond 7 pages
const pages: Array<number | 'ellipsis'> = (() => {
  const last = page.lastPage;
  const cur = page.currentPage;
  if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);
  const nums = [...new Set([1, last, cur - 1, cur, cur + 1])]
    .filter((n) => n >= 1 && n <= last)
    .sort((a, b) => a - b);
  const out: Array<number | 'ellipsis'> = [];
  let prev = 0;
  for (const n of nums) {
    if (n - prev > 1) out.push('ellipsis');
    out.push(n);
    prev = n;
  }
  return out;
})();
const basePath = locale === 'en' ? '/en/posts' : '/posts';
---

{showPagination && (
  <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
    {page.url.prev ? (
      <a
        href={page.url.prev}
        class="flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium text-muted hover:text-accent hover:bg-accent/5 dark:hover:bg-accent/10 transition-all active:scale-95"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {t(locale, 'common.prev')}
      </a>
    ) : (
      <span class="flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium text-border dark:text-white/20 cursor-not-allowed">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {t(locale, 'common.prev')}
      </span>
    )}

    <div class="flex items-center gap-1">
      {pages.map((num) => {
        if (num === 'ellipsis') {
          return (
            <span class="flex h-9 w-9 items-center justify-center text-sm text-muted" aria-hidden="true">
              &hellip;
            </span>
          );
        }
        const href = num === 1 ? `${basePath}/` : `${basePath}/${num}/`;
        const isCurrent = num === page.currentPage;
        return isCurrent ? (
          <span
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-accent text-sm font-bold text-white"
            aria-current="page"
          >
            {num}
          </span>
        ) : (
          <a
            href={href}
            class="flex h-9 w-9 items-center justify-center rounded-lg text-sm font-medium text-muted hover:text-accent hover:bg-accent/5 dark:hover:bg-accent/10 transition-all active:scale-95"
          >
            {num}
          </a>
        );
      })}
    </div>

    {page.url.next ? (
      <a
        href={page.url.next}
        class="flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium text-muted hover:text-accent hover:bg-accent/5 dark:hover:bg-accent/10 transition-all active:scale-95"
      >
        {t(locale, 'common.next')}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span class="flex items-center gap-1 rounded-lg px-4 py-2 text-sm font-medium text-border dark:text-white/20 cursor-not-allowed">
        {t(locale, 'common.next')}
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    )}
  </nav>
)}
