---
import { t, getAlternateLocalePath, type Locale } from '../../i18n/ui';
import { siteConfig } from '../../config/site';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
const currentYear = new Date().getFullYear();

const navGroups = [
  {
    label: locale === 'ko' ? '학과' : 'Department',
    links: [
      { key: 'about', href: `${prefix}/about/` },
      { key: 'faculty', href: `${prefix}/faculty/` },
      { key: 'posts', href: `${prefix}/posts/` },
    ],
  },
  {
    label: locale === 'ko' ? '교육' : 'Academics',
    links: [
      { key: 'curriculum', href: `${prefix}/curriculum/` },
      { key: 'research', href: `${prefix}/research/` },
      { key: 'career', href: `${prefix}/career/` },
    ],
  },
  {
    label: locale === 'ko' ? '정보' : 'Info',
    links: [
      { key: 'admissions', href: `${prefix}/admissions/` },
      { key: 'tips', href: `${prefix}/tips/` },
      { key: 'contact', href: `${prefix}/contact/` },
      { key: 'location', href: `${prefix}/location/` },
    ],
  },
];

const alternateLocale: Locale = locale === 'ko' ? 'en' : 'ko';
const alternatePath = getAlternateLocalePath(Astro.url, alternateLocale);
---

<footer class="bg-abyss text-slate-400">
  <div class="section-divider" aria-hidden="true"></div>
  <div class="container py-16 lg:py-20">
    <div class="grid grid-cols-1 gap-14 lg:grid-cols-[1.2fr_1fr] lg:gap-24">
      <div class="space-y-7">
        <a
          href={locale === 'ko' ? '/' : '/en/'}
          class="inline-flex items-center gap-3"
          aria-label={locale === 'en' ? 'Artificial Intelligence, Cheju Halla University' : '인공지능학과 제주한라대학교'}
        >
          <img
            src="/images/logo/logo-icon-white.svg"
            alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
            width="44"
            height="44"
            class="h-11 w-auto"
          />
          <div class="border-l border-white/15 pl-4 leading-tight">
            <p class="text-sm font-bold text-white">
              {locale === 'en' ? 'Artificial Intelligence' : '인공지능학과'}
            </p>
            <p class="mt-1 text-[10px] font-medium tracking-wide text-slate-400">
              {locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
            </p>
          </div>
        </a>

        <address class="max-w-lg space-y-1.5 text-sm leading-relaxed text-slate-400 not-italic">
          <p>{locale === 'ko' ? siteConfig.address.ko : siteConfig.address.en}</p>
          <p>
            <a href={`tel:${siteConfig.phone.replaceAll('-', '')}`} class="transition-colors hover:text-white">
              {siteConfig.phone}
            </a>
          </p>
          <p>
            <a href={`mailto:${siteConfig.email}`} class="transition-colors hover:text-white">
              {siteConfig.email}
            </a>
          </p>
        </address>

        <div class="flex items-center gap-2.5" aria-label="Social links">
          <a
            href={siteConfig.universityUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button flex h-10 w-10 items-center justify-center border border-white/10 text-slate-400 hover:text-white"
            aria-label={locale === 'en' ? 'Cheju Halla University website' : '제주한라대학교 홈페이지'}
          >
            <i class="ph ph-globe text-lg" aria-hidden="true"></i>
          </a>
          <a
            href={siteConfig.socials.youtube}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button flex h-10 w-10 items-center justify-center border border-white/10 text-slate-400 hover:text-white"
            aria-label="YouTube"
          >
            <i class="ph ph-youtube-logo text-lg" aria-hidden="true"></i>
          </a>
          <a
            href={siteConfig.socials.kakao}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-button flex h-10 w-10 items-center justify-center border border-white/10 text-slate-400 hover:text-white"
            aria-label="KakaoTalk"
          >
            <i class="ph ph-chats-circle text-lg" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {navGroups.map((group) => (
          <div>
            <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.15em] text-slate-400">
              {group.label}
            </p>
            <ul class="space-y-3 text-sm">
              {group.links.map((item) => (
                <li>
                  <a href={item.href} class="text-slate-400 transition-colors hover:text-white">
                    {t(locale, `nav.${item.key}`)}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  </div>

  <div class="border-t border-white/[0.06] bg-void">
    <div class="container">
      <div class="flex flex-wrap items-center justify-between gap-3 py-5 text-xs text-slate-400">
        <p>&copy; {currentYear} {t(locale, 'footer.copyright')}. All rights reserved.</p>
        <div class="flex items-center gap-3">
          <button
            id="back-to-top"
            aria-label={t(locale, 'footer.back_to_top')}
            class="flex items-center gap-1 transition-colors hover:text-white"
          >
            <i class="ph ph-arrow-up text-sm" aria-hidden="true"></i>
            {t(locale, 'footer.back_to_top')}
          </button>
          <span class="text-white/10" aria-hidden="true">|</span>
          <a href={`${prefix}/privacy/`} class="transition-colors hover:text-white">
            {t(locale, 'footer.privacy')}
          </a>
          <span class="text-white/10" aria-hidden="true">|</span>
          <a href={alternatePath} class="transition-colors hover:text-white" lang={alternateLocale}>
            {alternateLocale === 'en' ? 'EN' : 'KO'}
          </a>
          <span class="text-white/10" aria-hidden="true">|</span>
          <ThemeToggle locale={locale} class="h-8! w-8! text-slate-400 hover:text-white!" />
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
  });
</script>
