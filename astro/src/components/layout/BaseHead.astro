---
import '../../assets/styles/global.css';
import { siteConfig } from '../../config/site';
import { tagSlug } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: string;
}

const {
  title,
  description,
  image = '/images/og-default.jpg',
  locale = 'ko',
} = Astro.props;

const tagRouteMatch = Astro.url.pathname.match(/^(\/(?:en\/)?tags\/)([^/]+)\/?$/);
const canonicalPath = tagRouteMatch
  ? `${tagRouteMatch[1]}${encodeURIComponent(tagSlug(decodeURIComponent(tagRouteMatch[2])))}/`
  : Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogLocale = locale === 'ko' ? 'ko_KR' : 'en_US';
const alternateLocale = locale === 'ko' ? 'en' : 'ko';
const alternatePath =
  locale === 'ko'
    ? `/en${Astro.url.pathname}`
    : Astro.url.pathname.replace(/^\/en/, '') || '/';
const alternateURL = new URL(alternatePath, Astro.site);
const isLocalizedTagDetail = /^\/(?:en\/)?tags\/[^/]+\/?$/.test(Astro.url.pathname);
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<link
  rel="preload"
  href="/fonts/PretendardVariable-subset.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
{isHomepage && (
  <link
    rel="preload"
    as="image"
    type="image/avif"
    href="/images/home/hero-ai-lab-960.avif"
    imagesrcset="/images/home/hero-ai-lab-640.avif 640w, /images/home/hero-ai-lab-960.avif 960w, /images/home/hero-ai-lab.avif 1600w"
    imagesizes="(max-width: 1023px) calc(100vw - 2rem), min(58vw, 680px)"
    fetchpriority="high"
  />
)}

<!-- Dark-first init: runs before first paint; an explicit saved light preference wins. -->
<script is:inline>
  (function () {
    var stored = localStorage.getItem('theme');
    document.documentElement.classList.toggle('dark', stored !== 'light');
  })();
</script>

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={alternateLocale === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:site_name" content={locale === 'en' ? 'Cheju Halla University - Artificial Intelligence' : '제주한라대학교 인공지능학과'} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

<!-- Hreflang alternates. Localized tag vocabularies have no guaranteed pair. -->
{!isLocalizedTagDetail && (
  <>
    <link rel="alternate" hreflang="ko" href={locale === 'ko' ? canonicalURL : new URL(alternatePath, Astro.site)} />
    <link rel="alternate" hreflang="en" href={locale === 'en' ? canonicalURL : alternateURL} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/en/, '') || '/', Astro.site)} />
  </>
)}

<!-- Favicon -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": locale === 'en' ? "Cheju Halla University - Artificial Intelligence" : "제주한라대학교 인공지능학과",
  "url": siteConfig.url,
  "inLanguage": [locale === 'en' ? "en" : "ko"],
  "publisher": {
    "@type": "EducationalOrganization",
    "name": locale === 'en' ? "Cheju Halla University" : "제주한라대학교",
    "url": siteConfig.universityUrl
  }
})} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": locale === 'en' ? "Department of Artificial Intelligence, Cheju Halla University" : "제주한라대학교 인공지능학과",
  "alternateName": locale === 'en' ? "제주한라대학교 인공지능학과" : "Department of Artificial Intelligence, Cheju Halla University",
  "url": siteConfig.url,
  "logo": new URL(siteConfig.logo, siteConfig.url).href,
  "image": new URL('/images/og-default.jpg', siteConfig.url).href,
  "description": locale === 'en'
    ? "The Department of Artificial Intelligence at Cheju Halla University trains next-generation AI specialists through hands-on education in machine learning, NLP, computer vision, robotics, and cybersecurity."
    : "제주한라대학교 인공지능학과는 머신러닝, 자연어처리, 컴퓨터비전, 로봇공학, 사이버보안 분야의 실무 중심 AI 교육을 제공합니다.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address.streetAddress,
    "addressLocality": siteConfig.address.addressLocality,
    "addressRegion": siteConfig.address.addressRegion,
    "postalCode": siteConfig.address.postalCode,
    "addressCountry": siteConfig.address.addressCountry
  },
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "parentOrganization": {
    "@type": "CollegeOrUniversity",
    "name": locale === 'en' ? "Cheju Halla University" : "제주한라대학교",
    "url": siteConfig.universityUrl,
    "sameAs": [siteConfig.socials.wikipedia]
  },
  "sameAs": [siteConfig.universityUrl, ...Object.values(siteConfig.socials)]
})} />

<!-- Google Analytics: production only, so local previews stay private and deterministic. -->
<script is:inline>
  if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    var analyticsScript = document.createElement('script');
    analyticsScript.async = true;
    analyticsScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-QP4FVB9F1X';
    document.head.appendChild(analyticsScript);
  }
  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
    gtag('js', new Date());
    gtag('config', 'G-QP4FVB9F1X');
  }
</script>
