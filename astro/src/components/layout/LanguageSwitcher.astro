---
import { getAlternateLocalePath, tagUrl, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tagMatch = Astro.url.pathname.match(/^\/(?:en\/)?tags\/([^/]+)\/?$/);
const currentPath = tagMatch
  ? tagUrl(locale, decodeURIComponent(tagMatch[1]))
  : Astro.url.pathname;

---

<div class="lang-switch flex items-center gap-1 text-xs font-semibold" aria-label={locale === 'ko' ? '언어 선택' : 'Language selector'}>
  <a
    href={locale === 'ko' ? currentPath : getAlternateLocalePath(Astro.url, 'ko')}
    class={`rounded-md px-2.5 py-2 transition-colors duration-150 ${
      locale === 'ko'
        ? 'bg-accent-hover text-white'
        : 'text-muted hover:text-accent'
    }`}
    aria-label="KO, 한국어"
    lang="ko"
  >
    KO
  </a>
  <a
    href={locale === 'en' ? currentPath : getAlternateLocalePath(Astro.url, 'en')}
    class={`rounded-md px-2.5 py-2 transition-colors duration-150 ${
      locale === 'en'
        ? 'bg-accent-hover text-white'
        : 'text-muted hover:text-accent'
    }`}
    aria-label="EN, English"
    lang="en"
  >
    EN
  </a>
</div>
