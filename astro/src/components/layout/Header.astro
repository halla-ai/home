---
import { t, type Locale } from '../../i18n/ui';
import {
  isNavigationActive,
  navigationHref,
  primaryNavigation,
} from '../../config/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const currentPath = Astro.url.pathname;
const navItems = primaryNavigation.map((item) => ({
  ...item,
  href: navigationHref(locale, item),
}));
---

<header class={`site-header ${Astro.url.pathname === '/' || Astro.url.pathname === '/en/' ? 'header-transparent' : 'header-solid'}`}>
  <div class="container">
    <div class="flex min-h-[72px] items-center justify-between gap-4">
      <!-- Logo -->
      <a
        href={locale === 'ko' ? '/' : '/en/'}
        class="flex items-center gap-2.5 shrink-0 group"
        aria-label={locale === 'en' ? 'Artificial Intelligence, Cheju Halla University' : '인공지능학과 제주한라대학교'}
      >
        <img
          src="/images/logo/logo-icon.svg"
          alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
          width="40"
          height="40"
          class="logo-color h-10 w-auto"
        />
        <img
          src="/images/logo/logo-icon-white.svg"
          alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
          width="40"
          height="40"
          class="logo-white h-10 w-auto"
        />
        <div class="hidden sm:block leading-tight pl-2.5">
          <p class="nav-brand-text text-sm font-bold transition-colors duration-300">
            {locale === 'en' ? 'Artificial Intelligence' : '인공지능학과'}
          </p>
          <p class="nav-brand-sub text-[10px] font-medium tracking-wide transition-colors duration-300">
            {locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
          </p>
        </div>
      </a>

      <!-- Desktop nav: keep all seven primary links on one line at xl. -->
      <nav
        class="hidden min-w-0 flex-1 items-center justify-center gap-0.5 xl:flex"
        aria-label={locale === 'ko' ? '주요 메뉴' : 'Primary navigation'}
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link shrink-0 px-3 py-2 text-sm font-medium transition-colors duration-200"
              aria-current={isNavigationActive(currentPath, item.href) ? 'page' : undefined}
            >
              {t(locale, `nav.${item.key}`)}
            </a>
          ))
        }
      </nav>

      <!-- Right: language switcher + theme toggle + below-xl menu trigger -->
      <div class="flex items-center gap-2 shrink-0">
        <div class="hidden lg:block">
          <LanguageSwitcher locale={locale} />
        </div>
        <ThemeToggle locale={locale} />

        <!-- Full-width mega-menu trigger below xl -->
        <button
          id="mobile-open"
          type="button"
          aria-label={locale === 'ko' ? '메뉴 열기' : 'Open menu'}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="hamburger-btn inline-flex h-10 items-center justify-center gap-2 rounded-lg px-3 text-sm font-semibold xl:hidden"
        >
          <i class="ph ph-list text-lg" aria-hidden="true"></i>
          <span>{locale === 'ko' ? '메뉴' : 'Menu'}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<MobileMenu locale={locale} />

<script is:inline>
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;

    if (!document.body.classList.contains('has-hero')) return;

    var sentinel = document.getElementById('header-sentinel');
    if (!sentinel) return;

    var observer = new IntersectionObserver(function (entries) {
      var transparent = entries[0] && entries[0].isIntersecting;
      header.classList.toggle('header-transparent', transparent);
      header.classList.toggle('header-solid', !transparent);
    }, { threshold: 0 });

    observer.observe(sentinel);
  })();
</script>
