---
import { t, getAlternateLocalePath, tagUrl, type Locale } from '../../i18n/ui';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const prefix = locale === 'en' ? '/en' : '';
const tagMatch = Astro.url.pathname.match(/^\/(?:en\/)?tags\/([^/]+)\/?$/);
const currentPath = tagMatch
  ? tagUrl(locale, decodeURIComponent(tagMatch[1]))
  : Astro.url.pathname;

const primaryNavItems = [
  { key: 'about', href: `${prefix}/about/` },
  { key: 'faculty', href: `${prefix}/faculty/` },
  { key: 'curriculum', href: `${prefix}/curriculum/` },
  { key: 'research', href: `${prefix}/research/` },
  { key: 'posts', href: `${prefix}/posts/` },
  { key: 'career', href: `${prefix}/career/` },
  { key: 'admissions', href: `${prefix}/admissions/` },
];

const secondaryNavItems = [
  { key: 'tips', href: `${prefix}/tips/` },
  { key: 'contact', href: `${prefix}/contact/` },
  { key: 'location', href: `${prefix}/location/` },
];

---

<!-- Overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden opacity-0"
  aria-hidden="true"
></div>

<!-- Slide-out panel (translucent material; Motion drives its transform) -->
<div
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-72 max-w-full z-50 shadow-2xl flex flex-col bg-white/85 dark:bg-abyss/85 backdrop-blur-xl backdrop-saturate-[1.8]"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation"
  inert
>
  <!-- Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-border dark:border-white/[0.06]">
    <a href={locale === 'ko' ? '/' : '/en/'} class="flex items-center gap-2">
      <img
        src="/images/logo/logo-icon.svg"
        alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
        width="36"
        height="36"
        class="h-9 w-auto dark:hidden"
      />
      <img
        src="/images/logo/logo-icon-white.svg"
        alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
        width="36"
        height="36"
        class="h-9 w-auto hidden dark:block"
      />
      <div class="leading-tight pl-2">
        <p class="text-sm font-bold text-deep dark:text-white">{locale === 'en' ? 'Artificial Intelligence' : '인공지능학과'}</p>
        <p class="text-[10px] font-medium text-muted dark:text-slate-500 tracking-wide">{locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}</p>
      </div>
    </a>
    <button
      id="mobile-close"
      aria-label="Close menu"
      class="w-9 h-9 flex items-center justify-center rounded-lg text-muted hover:text-deep dark:hover:text-white hover:bg-surface dark:hover:bg-white/[0.05] transition-all active:scale-95"
    >
      <i class="ph ph-x text-xl" aria-hidden="true"></i>
    </button>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto py-4 px-5" aria-label="Mobile navigation links">
    <ul class="space-y-0.5">
      {
        primaryNavItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex items-center px-3 py-2.5 rounded-lg text-text-navy dark:text-slate-300 font-medium hover:bg-accent-light dark:hover:bg-accent/10 hover:text-accent active:bg-accent-light/70 dark:active:bg-accent/15 transition-colors duration-150"
            >
              {t(locale, `nav.${item.key}`)}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 pt-4 border-t border-border dark:border-white/[0.06]">
      <p class="px-3 mb-2 text-[11px] font-semibold text-muted uppercase tracking-wider">
        {locale === 'ko' ? '더보기' : 'More'}
      </p>
      <ul class="space-y-0.5">
        {
          secondaryNavItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center px-3 py-2 rounded-lg text-sm text-muted hover:text-accent hover:bg-accent-light dark:hover:bg-accent/10 active:bg-accent-light/70 dark:active:bg-accent/15 transition-colors duration-150"
              >
                {t(locale, `nav.${item.key}`)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <!-- Footer: theme + language -->
  <div class="border-t border-border dark:border-white/[0.06] px-5 py-4 flex items-center justify-between">
    <ThemeToggle locale={locale} />
    <div class="flex items-center gap-1 text-sm font-medium">
      <a
        href={locale === 'ko' ? currentPath : getAlternateLocalePath(Astro.url, 'ko')}
        class={`px-2 py-1 rounded-l border transition-all active:scale-95 ${locale === 'ko' ? 'bg-accent-hover text-white border-accent-hover' : 'border-border dark:border-white/10 text-muted hover:text-deep dark:hover:text-white'}`}
        lang="ko"
      >KO</a>
      <a
        href={locale === 'en' ? currentPath : getAlternateLocalePath(Astro.url, 'en')}
        class={`px-2 py-1 rounded-r border-t border-b border-r transition-all active:scale-95 ${locale === 'en' ? 'bg-accent-hover text-white border-accent-hover' : 'border-border dark:border-white/10 text-muted hover:text-deep dark:hover:text-white'}`}
        lang="en"
      >EN</a>
    </div>
  </div>
</div>

<style>
  /* Initial off-screen position uses `transform` (NOT Tailwind's translate-x-full,
     which in v4 sets the standalone `translate` property that Motion's
     transform animation cannot override). */
  #mobile-menu {
    transform: translateX(100%);
    box-shadow:
      -24px 0 48px rgba(0, 0, 0, 0.12),
      inset 1px 0 0 rgba(255, 255, 255, 0.4);
  }
  :global(.dark) #mobile-menu {
    box-shadow:
      -24px 0 48px rgba(0, 0, 0, 0.5),
      inset 1px 0 0 rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  import { animate } from 'motion';
  import { SPRING, reduced, project, rubberband } from '../../scripts/motion';

  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement;
  const openBtn = document.getElementById('mobile-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('mobile-close') as HTMLButtonElement;
  if (!menu || !overlay || !openBtn || !closeBtn) throw new Error('mobile menu: missing elements');

  let isOpen = false;

  const panelWidth = () => menu.offsetWidth || window.innerWidth;

  function showOverlay() {
    overlay.classList.remove('hidden');
    animate(overlay, { opacity: 1 }, { duration: reduced() ? 0.2 : 0.3 });
  }

  function hideOverlay() {
    animate(overlay, { opacity: 0 }, { duration: reduced() ? 0.2 : 0.3 }).then(() => {
      if (!isOpen) overlay.classList.add('hidden');
    });
  }

  function openMenu() {
    if (isOpen) return;
    isOpen = true;
    openBtn.setAttribute('aria-expanded', 'true');
    menu.removeAttribute('inert');
    document.body.style.overflow = 'hidden';
    showOverlay();
    if (reduced()) {
      // Cross-fade only — no slide under reduced motion
      animate(menu, { x: '0%' }, { duration: 0 });
      animate(menu, { opacity: [0, 1] }, { duration: 0.2 });
    } else {
      animate(menu, { x: ['100%', '0%'] }, SPRING.drawer);
    }
    closeBtn.focus();
  }

  function closeMenu(velocity = 0) {
    if (!isOpen) return;
    isOpen = false;
    openBtn.setAttribute('aria-expanded', 'false');
    menu.setAttribute('inert', '');
    document.body.style.overflow = '';
    hideOverlay();
    if (reduced()) {
      animate(menu, { opacity: [1, 0] }, { duration: 0.2 }).then(() => {
        if (!isOpen) animate(menu, { x: '100%' }, { duration: 0 });
      });
    } else {
      animate(menu, { x: '100%' }, { ...SPRING.drawer, velocity });
    }
    openBtn.focus();
  }

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', () => closeMenu());
  overlay.addEventListener('click', () => closeMenu());

  // Escape + focus trap, active only while the menu is open
  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    if (e.key === 'Tab') {
      const focusables = menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled])',
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  /* ── Drag-to-close (1:1 tracking + velocity handoff) ── */

  let dragging = false;
  let dragStarted = false; // past the 10px hysteresis threshold
  let startX = 0;
  let currentOffset = 0;
  let history: Array<{ x: number; t: number }> = [];

  function releaseVelocity(): number {
    const now = performance.now();
    const recent = history.filter((p) => now - p.t < 100);
    if (recent.length < 2) return 0;
    const first = recent[0];
    const last = recent[recent.length - 1];
    const dt = last.t - first.t;
    if (dt <= 0) return 0;
    return ((last.x - first.x) / dt) * 1000; // px/s
  }

  menu.addEventListener('pointerdown', (e) => {
    if (!isOpen || reduced()) return;
    dragging = true;
    dragStarted = false;
    startX = e.clientX;
    currentOffset = 0;
    history = [{ x: e.clientX, t: performance.now() }];
    // NOTE: no setPointerCapture here — capturing on pointerdown retargets
    // the click away from buttons/links inside the panel (the X button
    // and nav links would never fire). Capture only once the drag begins.
  });

  menu.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - startX;

    // Hysteresis: commit to the gesture only past 10px so taps still work
    if (!dragStarted) {
      if (Math.abs(dx) < 10) return;
      dragStarted = true;
      menu.setPointerCapture(e.pointerId);
    }

    history.push({ x: e.clientX, t: performance.now() });
    if (history.length > 8) history.shift();

    // 1:1 tracking rightward; rubber-band resistance leftward (nothing more there)
    currentOffset = dx > 0 ? dx : rubberband(dx, panelWidth());
    menu.style.transform = `translateX(${currentOffset}px)`;
    overlay.style.opacity = String(Math.max(0, 1 - currentOffset / panelWidth()));
  });

  function endDrag() {
    if (!dragging) return;
    dragging = false;
    if (!dragStarted) return;

    // NOTE: inline transform/opacity are intentionally left in place —
    // Motion reads the live presentation value and continues from it
    // (no jump at the drag → animation seam).

    const v = releaseVelocity();
    const width = panelWidth();
    const projected = currentOffset + project(v);

    // Decide by velocity sign first, then by projected resting position
    const dismiss = v > 250 || (v >= 0 && projected > width * 0.4);

    if (dismiss) {
      closeMenu(v);
    } else {
      animate(menu, { x: 0 }, { ...SPRING.drawer, velocity: v });
      animate(overlay, { opacity: 1 }, { duration: 0.2 });
    }
  }

  menu.addEventListener('pointerup', endDrag);
  menu.addEventListener('pointercancel', endDrag);

  // Suppress accidental link activation right after a drag
  menu.addEventListener(
    'click',
    (e) => {
      if (dragStarted) {
        e.preventDefault();
        e.stopPropagation();
        dragStarted = false;
      }
    },
    true,
  );
</script>
