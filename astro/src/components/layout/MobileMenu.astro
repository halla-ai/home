---
import { t, getAlternateLocalePath, tagUrl, type Locale } from '../../i18n/ui';
import {
  isNavigationActive,
  navigationGroups,
  navigationHref,
} from '../../config/navigation';
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tagMatch = Astro.url.pathname.match(/^\/(?:en\/)?tags\/([^/]+)\/?$/);
const currentPath = tagMatch
  ? tagUrl(locale, decodeURIComponent(tagMatch[1]))
  : Astro.url.pathname;
---

<!-- Overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-[var(--z-overlay)] hidden bg-black/60 opacity-0 backdrop-blur-sm"
  aria-hidden="true"
></div>

<!-- Full-width mega-menu (Motion drives its vertical reveal) -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 top-0 z-[var(--z-modal)] max-h-[100svh] overflow-y-auto bg-white/95 shadow-2xl backdrop-blur-xl backdrop-saturate-[1.8] dark:bg-abyss/95"
  role="dialog"
  aria-modal="true"
  aria-label={locale === 'ko' ? '전체 메뉴' : 'Main menu'}
  aria-hidden="true"
  inert
>
  <div class="container">
    <!-- Header -->
    <div
      id="mobile-menu-header"
      class="flex min-h-[72px] items-center justify-between gap-4 border-b border-border dark:border-white/[0.06]"
    >
      <a href={locale === 'ko' ? '/' : '/en/'} class="flex items-center gap-2">
        <img
          src="/images/logo/logo-icon.svg"
          alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
          width="36"
          height="36"
          class="h-9 w-auto dark:hidden"
        />
        <img
          src="/images/logo/logo-icon-white.svg"
          alt={locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}
          width="36"
          height="36"
          class="hidden h-9 w-auto dark:block"
        />
        <div class="leading-tight pl-2">
          <p class="text-sm font-bold text-deep dark:text-white">{locale === 'en' ? 'Artificial Intelligence' : '인공지능학과'}</p>
          <p class="text-[10px] font-medium tracking-wide text-muted dark:text-slate-500">{locale === 'en' ? 'Cheju Halla University' : '제주한라대학교'}</p>
        </div>
      </a>
      <button
        id="mobile-close"
        type="button"
        aria-label={locale === 'ko' ? '메뉴 닫기' : 'Close menu'}
        class="h-10 w-10 rounded-lg text-muted transition-all hover:bg-surface hover:text-deep active:scale-95 dark:hover:bg-white/[0.05] dark:hover:text-white"
      >
        <i class="ph ph-x text-xl" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Grouped navigation -->
    <nav class="py-7 md:py-9" aria-label={locale === 'ko' ? '전체 메뉴 링크' : 'Main navigation links'}>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
        {
          navigationGroups.map((group) => (
            <section aria-labelledby={`mobile-menu-group-${group.key}`}>
              <h2
                id={`mobile-menu-group-${group.key}`}
                class="text-sm font-semibold text-deep dark:text-white"
              >
                {group.label[locale]}
              </h2>
              <ul class="mt-3 space-y-1">
                {
                  group.items.map((item) => {
                    const href = navigationHref(locale, item);
                    const active = isNavigationActive(currentPath, href);
                    return (
                      <li>
                        <a
                          href={href}
                          class={`mega-nav-link group flex min-h-11 items-center justify-between gap-4 rounded-lg px-3 py-2.5 text-base font-semibold transition-colors duration-150 ${active ? 'bg-accent-light text-accent dark:bg-accent/15 dark:text-sky-300' : 'text-text-navy hover:bg-accent-light hover:text-accent dark:text-slate-200 dark:hover:bg-accent/10 dark:hover:text-sky-300'}`}
                          aria-current={active ? 'page' : undefined}
                        >
                          <span>{t(locale, `nav.${item.key}`)}</span>
                          <span class="text-accent opacity-0 transition-opacity duration-150 group-hover:opacity-100" aria-hidden="true">→</span>
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </section>
          ))
        }
      </div>
    </nav>

    <!-- Footer: theme + language -->
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border py-5 dark:border-white/[0.06]">
      <p class="text-sm text-muted dark:text-slate-400">{locale === 'ko' ? '화면 설정' : 'Display settings'}</p>
      <div class="flex items-center gap-3">
        <ThemeToggle locale={locale} />
        <div class="flex items-center gap-1 text-sm font-medium" aria-label={locale === 'ko' ? '언어 선택' : 'Language selector'}>
          <a
            href={locale === 'ko' ? currentPath : getAlternateLocalePath(Astro.url, 'ko')}
            class={`rounded-md px-2.5 py-2 transition-colors duration-150 ${locale === 'ko' ? 'bg-accent-hover text-white' : 'text-muted hover:text-accent'}`}
            aria-label="KO, 한국어"
            lang="ko"
          >KO</a>
          <a
            href={locale === 'en' ? currentPath : getAlternateLocalePath(Astro.url, 'en')}
            class={`rounded-md px-2.5 py-2 transition-colors duration-150 ${locale === 'en' ? 'bg-accent-hover text-white' : 'text-muted hover:text-accent'}`}
            aria-label="EN, English"
            lang="en"
          >EN</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Initial off-screen position uses `transform`, so Motion can continue from it. */
  #mobile-menu {
    transform: translateY(-100%);
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.12),
      inset 0 -1px 0 rgba(255, 255, 255, 0.4);
  }

  #mobile-menu-header {
    touch-action: none;
  }

  :global(.dark) #mobile-menu {
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.5),
      inset 0 -1px 0 rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  import { animate } from 'motion';
  import { SPRING, reduced, project, rubberband } from '../../scripts/motion';

  const menu = document.getElementById('mobile-menu') as HTMLElement;
  const overlay = document.getElementById('mobile-overlay') as HTMLElement;
  const openBtn = document.getElementById('mobile-open') as HTMLButtonElement;
  const closeBtn = document.getElementById('mobile-close') as HTMLButtonElement;
  const dragHandle = document.getElementById('mobile-menu-header') as HTMLElement;
  if (!menu || !overlay || !openBtn || !closeBtn || !dragHandle) throw new Error('mobile menu: missing elements');

  let isOpen = false;
  let previousBodyOverflow = '';

  const panelHeight = () => menu.offsetHeight || window.innerHeight;

  function showOverlay() {
    overlay.classList.remove('hidden');
    animate(overlay, { opacity: 1 }, { duration: reduced() ? 0.2 : 0.3 });
  }

  function hideOverlay() {
    animate(overlay, { opacity: 0 }, { duration: reduced() ? 0.2 : 0.3 }).then(() => {
      if (!isOpen) overlay.classList.add('hidden');
    });
  }

  function openMenu() {
    if (isOpen) return;
    isOpen = true;
    previousBodyOverflow = document.body.style.overflow;
    openBtn.setAttribute('aria-expanded', 'true');
    menu.removeAttribute('inert');
    menu.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    showOverlay();
    if (reduced()) {
      // Cross-fade only — no slide under reduced motion.
      animate(menu, { y: '0%' }, { duration: 0 });
      animate(menu, { opacity: [0, 1] }, { duration: 0.2 });
    } else {
      animate(menu, { opacity: 1 }, { duration: 0 });
      animate(menu, { y: ['-100%', '0%'] }, SPRING.drawer);
    }
    closeBtn.focus();
  }

  function closeMenu(velocity = 0) {
    if (!isOpen) return;
    isOpen = false;
    openBtn.setAttribute('aria-expanded', 'false');
    menu.setAttribute('inert', '');
    menu.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = previousBodyOverflow;
    hideOverlay();
    if (reduced()) {
      animate(menu, { opacity: [1, 0] }, { duration: 0.2 }).then(() => {
        if (!isOpen) animate(menu, { y: '-100%' }, { duration: 0 });
      });
    } else {
      animate(menu, { y: '-100%' }, { ...SPRING.drawer, velocity });
    }
    openBtn.focus();
  }

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', () => closeMenu());
  overlay.addEventListener('click', () => closeMenu());

  // Escape + focus trap, active only while the menu is open.
  document.addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') {
      closeMenu();
      return;
    }
    if (e.key === 'Tab') {
      const focusables = menu.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled])',
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  /* ── Drag-to-close (vertical sheet gesture + velocity handoff) ── */

  let dragging = false;
  let dragStarted = false;
  let startY = 0;
  let currentOffset = 0;
  let history: Array<{ y: number; t: number }> = [];

  function releaseVelocity(): number {
    const now = performance.now();
    const recent = history.filter((point) => now - point.t < 100);
    if (recent.length < 2) return 0;
    const first = recent[0];
    const last = recent[recent.length - 1];
    const dt = last.t - first.t;
    if (dt <= 0) return 0;
    return ((last.y - first.y) / dt) * 1000;
  }

  // Start from the header only so vertical scrolling in the menu remains native.
  dragHandle.addEventListener('pointerdown', (e) => {
    if (!isOpen || reduced()) return;
    dragging = true;
    dragStarted = false;
    startY = e.clientY;
    currentOffset = 0;
    history = [{ y: e.clientY, t: performance.now() }];
    // Capture only after the hysteresis threshold so taps keep activating links.
  });

  menu.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dy = e.clientY - startY;

    if (!dragStarted) {
      if (Math.abs(dy) < 10) return;
      dragStarted = true;
      menu.setPointerCapture(e.pointerId);
    }

    history.push({ y: e.clientY, t: performance.now() });
    if (history.length > 8) history.shift();

    // Track upward dismissal 1:1; rubber-band downward at the open boundary.
    currentOffset = dy < 0 ? dy : rubberband(dy, panelHeight());
    menu.style.transform = `translateY(${currentOffset}px)`;
    overlay.style.opacity = String(Math.max(0, 1 - Math.abs(currentOffset) / panelHeight()));
  });

  function endDrag() {
    if (!dragging) return;
    dragging = false;
    if (!dragStarted) return;

    // Motion reads the live transform and continues from it at the animation seam.
    const velocity = releaseVelocity();
    const height = panelHeight();
    const projected = currentOffset + project(velocity);
    const dismiss = velocity < -250 || (velocity <= 0 && projected < -height * 0.4);

    if (dismiss) {
      closeMenu(velocity);
    } else {
      animate(menu, { y: 0 }, { ...SPRING.drawer, velocity });
      animate(overlay, { opacity: 1 }, { duration: 0.2 });
    }
  }

  menu.addEventListener('pointerup', endDrag);
  menu.addEventListener('pointercancel', endDrag);
  document.addEventListener('pointerup', endDrag);
  document.addEventListener('pointercancel', endDrag);

  // Suppress accidental link activation right after a drag.
  menu.addEventListener(
    'click',
    (e) => {
      if (dragStarted) {
        e.preventDefault();
        e.stopPropagation();
        dragStarted = false;
      }
    },
    true,
  );
</script>
