---
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const allTestimonials = await getCollection('testimonials');
const testimonials = allTestimonials
  .filter((item) => item.id.startsWith(`${locale}/`))
  .sort((a, b) => a.data.order - b.data.order)
  .map((item) => {
    const clean = item.data.content.replace(/\s+/g, ' ').replace(/\u2014|\u2013/g, ',').trim();
    return {
      ...item,
      excerpt: clean.length > 230 ? `${clean.slice(0, 230).trim()}...` : clean,
    };
  });

const positionLabel = (current: number, total: number) =>
  t(locale, 'home.stories.position').replace('{current}', String(current)).replace('{total}', String(total));
---

<section class="home-stories bg-stone py-20 dark:bg-abyss md:py-28">
  <div class="container">
    <div class="mb-10 flex items-end justify-between gap-6 fade-up">
      <h2 id="home-stories-title" class="text-3xl font-bold leading-tight tracking-[-0.045em] text-deep dark:text-white md:text-5xl">
        {t(locale, 'home.stories.title')}
      </h2>
      <span class="hidden font-mono text-xs tracking-[0.14em] text-muted dark:text-slate-400 sm:block" data-story-status>
        {positionLabel(1, testimonials.length)}
      </span>
    </div>

    {testimonials.length > 0 && (
      <div
        class="home-story-carousel fade-up"
        data-story-carousel
        role="region"
        aria-roledescription="carousel"
        aria-labelledby="home-stories-title"
      >
        <div class="home-story-live" aria-live="polite">
          {testimonials.map((item, index) => (
            <article
              class:list={['home-story-slide', { 'is-active': index === 0 }]}
              data-story-slide
              data-index={index}
              id={`home-story-slide-${index}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
              hidden={index !== 0}
            >
              <div class="grid items-start gap-8 md:grid-cols-[13rem_1fr] md:gap-14">
                <div class="flex items-center gap-4 md:block">
                  <img
                    src={item.data.photo}
                    alt={item.data.name}
                    class="h-16 w-16 rounded-md object-cover md:h-40 md:w-40"
                    loading="lazy"
                  />
                  <div class="mt-0 md:mt-4">
                    <h3 class="text-base font-bold text-deep dark:text-white">{item.data.name}</h3>
                    <p class="mt-1 text-sm text-accent">{item.data.designation}</p>
                  </div>
                </div>
                <blockquote class="max-w-3xl border-l-2 border-accent pl-6 text-xl leading-[1.55] tracking-[-0.02em] text-deep dark:text-slate-200 md:pl-8 md:text-3xl">
                  "{item.excerpt}"
                </blockquote>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-between gap-5 border-t border-deep/10 pt-5 dark:border-white/10">
          <div class="flex items-center gap-2" role="tablist" aria-label={locale === 'ko' ? '학생 이야기 선택' : 'Choose a student story'}>
            {testimonials.map((item, index) => (
              <button
                type="button"
                role="tab"
                class="home-story-dot"
                data-story-tab={index}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`home-story-slide-${index}`}
                aria-label={t(locale, 'home.stories.go_to').replace('{name}', item.data.name)}
              >
                <span class="sr-only">{item.data.name}</span>
              </button>
            ))}
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="home-story-control"
              data-story-prev
              aria-label={t(locale, 'home.stories.previous')}
            >
              <span aria-hidden="true">←</span>
            </button>
            <button
              type="button"
              class="home-story-control"
              data-story-next
              aria-label={t(locale, 'home.stories.next')}
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .home-story-carousel {
    overflow: hidden;
  }

  .home-story-slide[hidden] {
    display: none;
  }

  .home-story-slide.is-active {
    animation: story-enter 360ms var(--ease-out-expo) both;
  }

  .home-story-dot {
    width: 2.25rem;
    height: 0.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-deep) 18%, transparent);
    transition: background-color 180ms ease, transform 180ms ease;
  }

  .home-story-dot[aria-selected='true'] {
    background: var(--color-accent);
  }

  .home-story-dot:hover {
    transform: scaleY(1.6);
    background: var(--color-accent);
  }

  .home-story-control {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-deep) 18%, transparent);
    border-radius: 0.45rem;
    color: var(--color-deep);
    font-size: 1.1rem;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .dark .home-story-dot {
    background: rgba(255, 255, 255, 0.2);
  }

  .dark .home-story-control {
    border-color: rgba(255, 255, 255, 0.18);
    color: var(--color-text-bright);
  }

  .home-story-control:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: white;
  }

  .home-story-control:active {
    transform: translateY(1px) scale(0.97);
  }

  @keyframes story-enter {
    from {
      opacity: 0;
      transform: translateY(0.6rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .home-story-slide blockquote {
      padding-left: 1rem;
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-story-slide.is-active {
      animation: none;
    }

    .home-story-dot,
    .home-story-control {
      transition: none;
    }
  }
</style>

<script>
  const setupStoryCarousel = (root: HTMLElement) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-story-slide]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-story-tab]'));
    const previous = root.querySelector<HTMLButtonElement>('[data-story-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-story-next]');
    const status = root.parentElement?.querySelector<HTMLElement>('[data-story-status]');
    if (slides.length < 1) return;

    let current = 0;
    const render = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === current;
        slide.hidden = !active;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute('aria-selected', String(tabIndex === current));
      });
      if (status) status.textContent = `${current + 1} / ${slides.length}`;
    };

    previous?.addEventListener('click', () => render(current - 1));
    next?.addEventListener('click', () => render(current + 1));
    tabs.forEach((tab, index) => tab.addEventListener('click', () => render(index)));
  };

  document.querySelectorAll<HTMLElement>('[data-story-carousel]').forEach(setupStoryCarousel);
</script>
