---
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';

const routes = [
  {
    number: '01',
    title: t(locale, 'home.routes.education_title'),
    body: t(locale, 'home.routes.education_body'),
    link: t(locale, 'home.routes.education_link'),
    href: `${prefix}/curriculum/`,
  },
  {
    number: '02',
    title: t(locale, 'home.routes.research_title'),
    body: t(locale, 'home.routes.research_body'),
    link: t(locale, 'home.routes.research_link'),
    href: `${prefix}/research/`,
  },
  {
    number: '03',
    title: t(locale, 'home.routes.industry_title'),
    body: t(locale, 'home.routes.industry_body'),
    link: t(locale, 'home.routes.industry_link'),
    href: `${prefix}/career/`,
  },
];
---

<section class="home-routes bg-abyss py-20 text-white md:py-28">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div class="max-w-md fade-up">
        <h2 class="text-3xl font-bold leading-tight tracking-[-0.04em] text-white md:text-5xl">
          {t(locale, 'home.routes.title')}
        </h2>
        <p class="mt-6 text-base leading-7 text-slate-400 md:text-lg">
          {t(locale, 'home.routes.body')}
        </p>
      </div>

      <nav aria-label={locale === 'ko' ? '학과 주요 경로' : 'Department pathways'} class="home-route-list">
        {routes.map((route, index) => (
          <a
            href={route.href}
            class={`home-route group fade-up fade-up-d${index + 1}`}
          >
            <span class="home-route-number" aria-hidden="true">{route.number}</span>
            <span class="home-route-copy">
              <span class="home-route-title">{route.title}</span>
              <span class="home-route-body">{route.body}</span>
              <span class="home-route-link">{route.link} <span aria-hidden="true">→</span></span>
            </span>
            <span class="home-route-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </div>
  </div>
</section>

<style>
  .home-route-list {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .home-route {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
    padding: 1.4rem 0 1.5rem;
    color: white;
    transition: padding-left 280ms var(--ease-out-expo), border-color 220ms ease;
  }

  .home-route:hover {
    padding-left: 0.7rem;
    border-color: var(--color-accent);
    color: white;
  }

  .home-route-number {
    padding-top: 0.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .home-route-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .home-route-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .home-route-body {
    max-width: 34rem;
    margin-top: 0.55rem;
    color: rgba(203, 213, 225, 0.75);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .home-route-link {
    margin-top: 0.85rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .home-route-arrow {
    padding-top: 0.1rem;
    color: rgba(255, 255, 255, 0.42);
    font-size: 1.25rem;
    transition: color 220ms ease, transform 280ms var(--ease-out-expo);
  }

  .home-route:hover .home-route-arrow {
    color: var(--color-accent);
    transform: translate(0.25rem, -0.25rem);
  }

  @media (max-width: 767px) {
    .home-route {
      grid-template-columns: 2.75rem minmax(0, 1fr) auto;
      gap: 0.65rem;
      padding-block: 1.25rem;
    }

    .home-route:hover {
      padding-left: 0.35rem;
    }

    .home-route-body {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-route,
    .home-route-arrow {
      transition: none;
    }

    .home-route:hover {
      padding-left: 0;
    }
  }
</style>
