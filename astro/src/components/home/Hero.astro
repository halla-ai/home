---
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
---

<section class="home-hero relative overflow-hidden bg-void text-white">
  <picture class="absolute inset-0 block h-full w-full" aria-hidden="true">
    <source
      srcset="/images/home/hero-topology-960.avif 960w, /images/home/hero-topology.avif 1920w"
      sizes="100vw"
      type="image/avif"
    />
    <source
      srcset="/images/home/hero-topology-960.webp 960w, /images/home/hero-topology.webp 1920w"
      sizes="100vw"
      type="image/webp"
    />
    <img
      src="/images/home/hero-topology.jpg"
      alt=""
      width="1920"
      height="1080"
      class="h-full w-full object-cover object-center opacity-80"
      fetchpriority="low"
    />
  </picture>
  <div class="home-hero-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="container relative z-10 flex min-h-[min(760px,100dvh)] items-center py-24 md:py-20 lg:py-16">
    <div class="grid w-full items-center gap-10 lg:grid-cols-[0.84fr_1.16fr] lg:gap-14">
      <div class="max-w-xl">
        <p class="text-xs font-medium tracking-[0.2em] text-accent md:text-sm">
          {t(locale, 'home.hero.eyebrow')}
        </p>
        <h1 class="mt-5 max-w-[11ch] text-[clamp(2.75rem,6vw,5.4rem)] font-extrabold leading-[0.98] tracking-[-0.055em] text-white">
          {t(locale, 'home.hero.title')}
        </h1>
        <p class="mt-6 max-w-[34rem] text-base leading-7 text-slate-300 md:text-lg">
          {t(locale, 'home.hero.body')}
        </p>
        <div class="hero-reveal hero-reveal-3 mt-8 flex flex-wrap items-center gap-3">
          <a
            href={`${prefix}/admissions/`}
            class="inline-flex items-center gap-3 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-white transition-[background-color,transform,box-shadow] duration-300 hover:bg-accent-hover hover:shadow-[0_12px_32px_rgba(61,126,219,0.24)] active:translate-y-px"
          >
            {t(locale, 'home.hero.primary')}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href={`${prefix}/about/`}
            class="inline-flex items-center gap-3 rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-white/90 transition-[background-color,border-color,transform] duration-300 hover:border-accent hover:bg-white/5 hover:text-white active:translate-y-px"
          >
            {t(locale, 'home.hero.secondary')}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="relative lg:justify-self-end">
        <figure class="relative ml-auto w-full max-w-[680px] overflow-hidden rounded-[1.15rem] border border-white/15 bg-deep shadow-[0_24px_80px_rgba(0,0,0,0.34)] lg:rotate-[1.2deg]">
          <div class="absolute inset-0 z-10 bg-gradient-to-t from-void/45 via-transparent to-transparent" aria-hidden="true"></div>
          <picture class="block">
            <source
              srcset="/images/home/hero-ai-lab-640.avif 640w, /images/home/hero-ai-lab-960.avif 960w, /images/home/hero-ai-lab.avif 1600w"
              sizes="(max-width: 1023px) calc(100vw - 2rem), min(58vw, 680px)"
              type="image/avif"
            />
            <source
              srcset="/images/home/hero-ai-lab-640.webp 640w, /images/home/hero-ai-lab-960.webp 960w, /images/home/hero-ai-lab.webp 1600w"
              sizes="(max-width: 1023px) calc(100vw - 2rem), min(58vw, 680px)"
              type="image/webp"
            />
            <img
              src="/images/home/hero-ai-lab.jpg"
              alt={t(locale, 'home.hero.visual_alt')}
              width="1600"
              height="1200"
              sizes="(max-width: 1023px) calc(100vw - 2rem), min(58vw, 680px)"
              class="block aspect-[4/3] h-full w-full object-cover object-center"
              fetchpriority="high"
            />
          </picture>
        </figure>
        <div class="pointer-events-none absolute -bottom-5 -left-5 h-20 w-20 border-b border-l border-accent/70" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero-scrim {
    background:
      linear-gradient(90deg, rgba(5, 10, 18, 0.94) 0%, rgba(5, 10, 18, 0.78) 38%, rgba(5, 10, 18, 0.34) 72%, rgba(5, 10, 18, 0.52) 100%),
      linear-gradient(0deg, rgba(5, 10, 18, 0.78) 0%, transparent 44%, rgba(5, 10, 18, 0.2) 100%);
  }

  @media (max-width: 767px) {
    .home-hero .container {
      min-height: 0;
      padding-top: 7.25rem;
      padding-bottom: 3.5rem;
    }

    .home-hero-scrim {
      background:
        linear-gradient(180deg, rgba(5, 10, 18, 0.9) 0%, rgba(5, 10, 18, 0.72) 52%, rgba(5, 10, 18, 0.88) 100%),
        linear-gradient(90deg, rgba(5, 10, 18, 0.82), rgba(5, 10, 18, 0.4));
    }

    .home-hero figure {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero figure {
      transform: none;
    }
  }
</style>
