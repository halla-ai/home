---
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const prefix = locale === 'en' ? '/en' : '';
const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((post) => post.id.startsWith(`${locale}/`) && !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const cleanVisibleText = (value: string) => value.replace(/\u2014|\u2013/g, ':');
const formatDate = (date: Date) =>
  date.toLocaleDateString(locale === 'ko' ? 'ko-KR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

const homeImages: Record<string, { src: string; width: number; height: number }> = {
  '2026-05-15-kbs-jeju-election-center-ai': { src: '/images/home/news-featured.webp', width: 960, height: 497 },
  '2026-04-04-2026mt': { src: '/images/home/news-mt.webp', width: 320, height: 214 },
  '2026-02-27-rise-performance-forum': { src: '/images/home/news-rise.webp', width: 320, height: 427 },
  '2026-02-13-stanford-dschool-reunion': { src: '/images/home/news-stanford.webp', width: 320, height: 240 },
};
---

<section class="home-news bg-stone py-20 dark:bg-abyss md:py-28">
  <div class="container">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-5 fade-up">
      <h2 class="text-3xl font-bold leading-tight tracking-[-0.045em] text-deep dark:text-white md:text-5xl">
        {t(locale, 'home.news.title')}
      </h2>
      <a href={`${prefix}/posts/`} class="text-sm font-semibold text-accent transition-colors duration-200 hover:text-accent-hover">
        {t(locale, 'home.news.all')} <span aria-hidden="true">→</span>
      </a>
    </div>

    {posts.length > 0 && (
      <div class="grid gap-8 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14">
        {(() => {
          const featured = posts[0];
          const slug = featured.id.replace(`${locale}/`, '');
          const homeImage = homeImages[slug];
          return (
            <a href={`${prefix}/posts/${slug}/`} class="group block fade-up">
              {featured.data.image ? (
                <div class="relative overflow-hidden rounded-[1rem] bg-deep">
                  <img
                    src={homeImage?.src ?? featured.data.image}
                    alt={cleanVisibleText(featured.data.title)}
                    width={homeImage?.width}
                    height={homeImage?.height}
                    class="block aspect-[1.65/1] w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
                    loading="lazy"
                  />
                  <span class="absolute left-4 top-4 rounded-sm bg-void/80 px-2 py-1 text-[0.65rem] font-semibold tracking-[0.12em] text-white backdrop-blur-sm">
                    {t(locale, 'home.news.featured')}
                  </span>
                </div>
              ) : null}
              <div class="mt-5 max-w-2xl">
                <time class="font-mono text-[0.68rem] tracking-[0.1em] text-muted dark:text-slate-400" datetime={featured.data.date.toISOString()}>
                  {formatDate(featured.data.date)}
                </time>
                <h3 class="mt-3 text-2xl font-bold leading-tight tracking-[-0.03em] text-deep transition-colors duration-200 group-hover:text-accent dark:text-white md:text-3xl">
                  {cleanVisibleText(featured.data.title)}
                </h3>
                {featured.data.description && (
                  <p class="mt-3 line-clamp-2 text-sm leading-6 text-muted dark:text-slate-400">
                    {cleanVisibleText(featured.data.description)}
                  </p>
                )}
              </div>
            </a>
          );
        })()}

        <div class="divide-y divide-deep/10 border-t border-deep/10 dark:divide-white/10 dark:border-white/10">
          {posts.slice(1).map((post) => {
            const slug = post.id.replace(`${locale}/`, '');
            const homeImage = homeImages[slug];
            return (
              <a href={`${prefix}/posts/${slug}/`} class="home-news-item group grid gap-3 py-5 sm:grid-cols-[5.5rem_1fr] sm:gap-5">
                {post.data.image ? (
                  <img
                    src={homeImage?.src ?? post.data.image}
                    alt={cleanVisibleText(post.data.title)}
                    width={homeImage?.width}
                    height={homeImage?.height}
                    class="aspect-[4/3] w-full rounded-md object-cover"
                    loading="lazy"
                  />
                ) : (
                  <span class="hidden aspect-[4/3] rounded-md bg-deep sm:block" aria-hidden="true"></span>
                )}
                <span class="flex flex-col justify-center">
                  <time class="font-mono text-[0.65rem] tracking-[0.08em] text-muted dark:text-slate-400" datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <span class="mt-2 line-clamp-2 text-base font-semibold leading-snug text-deep transition-colors duration-200 group-hover:text-accent dark:text-white">
                    {cleanVisibleText(post.data.title)}
                  </span>
                  <span class="mt-2 text-xs font-semibold text-accent opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                    {t(locale, 'home.news.read')} <span aria-hidden="true">→</span>
                  </span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .home-news-item img {
    transition: transform 500ms var(--ease-out-expo), opacity 220ms ease;
  }

  .home-news-item:hover img {
    transform: scale(1.035);
  }

  @media (max-width: 767px) {
    .home-news-item .opacity-0 {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-news-item img {
      transition: none;
    }

    .home-news-item:hover img {
      transform: none;
    }
  }
</style>
