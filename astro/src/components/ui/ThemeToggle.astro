---
import type { Locale } from '../../i18n/ui';

interface Props {
  class?: string;
  locale?: Locale;
}
const { class: className = '', locale = 'ko' } = Astro.props;
const label = locale === 'ko' ? '다크 모드 전환' : 'Toggle dark mode';
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  aria-pressed="false"
  class={`theme-toggle inline-flex items-center justify-center w-10 h-10 ${className}`}
>
  <i data-icon="sun" class="ph ph-sun hidden text-xl" aria-hidden="true"></i>
  <i data-icon="moon" class="ph ph-moon text-xl" aria-hidden="true"></i>
</button>

<script>
  // Multi-instance: wires every [data-theme-toggle] on the page.
  // Theme itself is initialized in BaseHead (before paint); here we only
  // reflect and mutate the .dark class on <html>.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function syncAll() {
    const dark = document.documentElement.classList.contains('dark');
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.querySelector('[data-icon="sun"]')?.classList.toggle('hidden', !dark);
      toggle.querySelector('[data-icon="moon"]')?.classList.toggle('hidden', dark);
    });
  }

  toggles.forEach((toggle) =>
    toggle.addEventListener('click', () => {
      const dark = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', dark);
      localStorage.setItem('theme', dark ? 'dark' : 'light');
      syncAll();
    }),
  );

  syncAll();
</script>
