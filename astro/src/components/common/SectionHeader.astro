---
interface Props {
  title: string;
  viewAllHref?: string;
  viewAllLabel?: string;
}

const { title, viewAllHref, viewAllLabel = 'View All' } = Astro.props;
---

<div class="flex items-end justify-between mb-10 fade-up">
  <div>
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-deep dark:text-white">
      {title}
    </h2>
    <div class="mt-3 w-10 h-[3px] rounded-full bg-accent" aria-hidden="true"></div>
  </div>

  {
    viewAllHref && (
      <a
        href={viewAllHref}
        class="text-sm font-medium text-accent hover:text-accent-hover flex items-center gap-1.5 transition-colors duration-200 group"
      >
        {viewAllLabel}
        <i class="ph ph-arrow-right text-base transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true"></i>
      </a>
    )
  }
</div>
