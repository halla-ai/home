---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { t, tagUrl, type Locale } from '../i18n/ui';
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  date: Date | string;
  tags?: string[];
  image?: string;
  readingTime?: number;
  author?: string;
  locale?: Locale;
  prev?: { title: string; slug: string } | null;
  next?: { title: string; slug: string } | null;
}

const {
  title,
  description,
  date,
  tags = [],
  image,
  readingTime,
  author,
  locale = 'ko',
  prev = null,
  next = null,
} = Astro.props;

const displayAuthor = author || (locale === 'en' ? 'Dept. of AI, Cheju Halla University' : '제주한라대학교 인공지능학과');

const prefix = locale === 'en' ? '/en' : '';
const postsHref = `${prefix}/posts/`;

const formattedDate = new Date(date).toLocaleDateString(locale === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const crumbs = [
  { label: t(locale, 'common.breadcrumb_home'), href: locale === 'en' ? '/en/' : '/' },
  { label: t(locale, 'nav.posts'), href: postsHref },
  { label: title },
];

const pageTitle = `${title} | ${t(locale, 'site.title')}`;
---

<BaseLayout title={pageTitle} description={description} image={image} locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description,
    "datePublished": new Date(date).toISOString(),
    "url": Astro.url.href,
    ...(image ? { "image": new URL(image, Astro.site).href } : {}),
    ...(tags.length > 0 ? { "keywords": tags.join(', ') } : {}),
    "author": {
      "@type": author ? "Person" : "Organization",
      "name": displayAuthor
    },
    "inLanguage": locale === 'en' ? 'en' : 'ko',
    "publisher": {
      "@type": "EducationalOrganization",
      "name": locale === 'en' ? "Department of Artificial Intelligence, Cheju Halla University" : "제주한라대학교 인공지능학과",
      "url": "https://halla.ai",
      "logo": { "@type": "ImageObject", "url": new URL(siteConfig.logo, siteConfig.url).href }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href }
  })} />
  <article class="pb-24 lg:pb-32">
    <!-- Post header -->
    <header class="page-hero cinematic-surface py-20 lg:py-28">
      <div class="container relative z-10">
        <Breadcrumb items={crumbs} />

        <!-- Tags -->
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-5">
              {tags.map((tag) => (
                <a
                  href={tagUrl(locale, tag)}
                  class="inline-block px-3 py-1 text-xs font-medium rounded-full bg-white/10 text-white/90 hover:bg-accent hover:text-white transition-all duration-200"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )
        }

        <h1 class="mt-5 text-3xl lg:text-[2.75rem] font-bold leading-tight">
          {title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 mt-5 text-sm text-slate-400">
          <span class="flex items-center gap-1.5">
            <i class="ph ph-user text-base text-accent" aria-hidden="true"></i>
            {displayAuthor}
          </span>
          <time datetime={new Date(date).toISOString()} class="flex items-center gap-1.5">
            <i class="ph ph-calendar-blank text-base text-accent" aria-hidden="true"></i>
            {formattedDate}
          </time>
          {
            readingTime && (
              <span class="flex items-center gap-1.5">
                <i class="ph ph-clock text-base text-accent" aria-hidden="true"></i>
                {readingTime} {t(locale, 'common.min_read')}
              </span>
            )
          }
        </div>
      </div>
    </header>

    <!-- Hero image -->
    {
      image && (
        <div class="container -mt-6 relative z-10">
          <img
            src={image}
            alt={title}
            class="w-full max-h-[480px] object-cover rounded-2xl shadow-lg ring-1 ring-black/5 dark:ring-white/5"
            loading="eager"
          />
        </div>
      )
    }

    <!-- Post body -->
    <div class="container mt-16 lg:mt-24">
      <div class="max-w-3xl mx-auto">
        <div class="prose prose-lg max-w-none">
          <slot />
        </div>

        <!-- Image Gallery (populated by script from prose images) -->
        <div id="post-gallery" class="mt-14 pt-8 border-t border-border dark:border-white/[0.08] hidden">
          <h2 class="text-lg font-bold text-deep dark:text-white mb-4">{locale === 'ko' ? '사진' : 'Gallery'}</h2>
          <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2"></div>
        </div>

        <!-- Lightbox -->
        <div
          id="lightbox"
          class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm hidden items-center justify-center cursor-zoom-out"
          role="dialog"
          aria-modal="true"
          aria-label={locale === 'ko' ? '이미지 확대 보기' : 'Image viewer'}
          aria-hidden="true"
        >
          <button id="lightbox-close" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors z-10" aria-label={locale === 'ko' ? '닫기' : 'Close'}>
            <i class="ph ph-x text-xl" aria-hidden="true"></i>
          </button>
          <button id="lightbox-prev" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors z-10" aria-label={locale === 'ko' ? '이전 이미지' : 'Previous image'}>
            <i class="ph ph-caret-left text-xl" aria-hidden="true"></i>
          </button>
          <button id="lightbox-next" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors z-10" aria-label={locale === 'ko' ? '다음 이미지' : 'Next image'}>
            <i class="ph ph-caret-right text-xl" aria-hidden="true"></i>
          </button>
          <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl cursor-default" alt="" />
        </div>

        <!-- Share -->
        <div class="mt-14 pt-8 border-t border-border dark:border-white/[0.08] flex items-center justify-between flex-wrap gap-4">
          <p class="text-sm font-medium text-muted dark:text-slate-400">{t(locale, 'common.share')}</p>
          <div class="flex gap-2">
            <a
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-xs font-medium rounded-lg bg-surface dark:bg-white/[0.06] border border-border dark:border-white/10 text-muted hover:text-accent hover:border-accent transition-all duration-200"
            >
              Twitter / X
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 text-xs font-medium rounded-lg bg-surface dark:bg-white/[0.06] border border-border dark:border-white/10 text-muted hover:text-accent hover:border-accent transition-all duration-200"
            >
              Facebook
            </a>
          </div>
        </div>

        <!-- Post navigation -->
        {
          (prev || next) && (
            <nav
              class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4"
              aria-label="Post navigation"
            >
              {prev && (
                <a
                  href={`${postsHref}${prev.slug}/`}
                  class="group flex flex-col gap-1.5 p-5 rounded-xl border border-border dark:border-white/10 hover:border-accent hover:shadow-sm transition-all duration-200"
                >
                  <span class="text-xs text-muted flex items-center gap-1">
                    <i class="ph ph-arrow-left text-sm" aria-hidden="true"></i>
                    {t(locale, 'common.prev')}
                  </span>
                  <span class="text-sm font-medium text-deep dark:text-white group-hover:text-accent transition-colors line-clamp-2">
                    {prev.title}
                  </span>
                </a>
              )}
              {next && (
                <a
                  href={`${postsHref}${next.slug}/`}
                  class="group flex flex-col gap-1.5 p-5 rounded-xl border border-border dark:border-white/10 hover:border-accent hover:shadow-sm transition-all duration-200 sm:text-right sm:col-start-2"
                >
                  <span class="text-xs text-muted flex items-center gap-1 sm:justify-end">
                    {t(locale, 'common.next')}
                    <i class="ph ph-arrow-right text-sm" aria-hidden="true"></i>
                  </span>
                  <span class="text-sm font-medium text-deep dark:text-white group-hover:text-accent transition-colors line-clamp-2">
                    {next.title}
                  </span>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </article>

  <!-- Gallery + Lightbox script -->
  <script>
    import { animate } from 'motion';
    import { SPRING, reduced } from '../scripts/motion';

    const prose = document.querySelector('.prose');
    const gallery = document.getElementById('post-gallery');
    const grid = document.getElementById('gallery-grid');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');

    if (prose && gallery && grid && lightbox && lightboxImg && btnClose && btnPrev && btnNext) {
      const isKo = document.documentElement.lang === 'ko';

      type Item = { src: string; alt: string; el: HTMLImageElement };

      // Collect prose images, waiting for lazy decodes so the tiny-image
      // filter (icons, badges) reads a real naturalWidth.
      const collect = async (): Promise<Item[]> => {
        const imgs = Array.from(prose.querySelectorAll('img'));
        const items: Array<Item | null> = await Promise.all(
          imgs.map(async (img) => {
            try {
              if (!img.complete) await img.decode();
            } catch {
              /* decode failed — fall through with whatever state we have */
            }
            if (img.naturalWidth > 0 && img.naturalWidth < 50) return null;
            return {
              src: img.getAttribute('src') || '',
              alt: img.getAttribute('alt') || '',
              el: img,
            };
          }),
        );
        return items.filter((i): i is Item => i !== null);
      };

      collect().then((collected) => {
        if (collected.length < 2) return; // No gallery for 0-1 images

        let current = 0;
        let isOpen = false;
        let originTile: HTMLElement | null = null;

        const show = (index: number) => {
          current = (index + collected.length) % collected.length;
          lightboxImg.src = collected[current].src;
          lightboxImg.alt = collected[current].alt;
        };

        const openLightbox = (index: number, tile: HTMLElement) => {
          isOpen = true;
          originTile = tile;
          show(index);
          lightbox.classList.remove('hidden');
          lightbox.classList.add('flex');
          lightbox.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';

          // Grow from where the user clicked (spatial consistency)
          const tr = tile.getBoundingClientRect();
          const ir = lightboxImg.getBoundingClientRect();
          lightboxImg.style.transformOrigin = `${tr.left + tr.width / 2 - ir.left}px ${tr.top + tr.height / 2 - ir.top}px`;

          if (reduced()) {
            animate(lightbox, { opacity: [0, 1] }, { duration: 0.2 });
          } else {
            // Materialize: blur + scale arrive together, not a plain fade
            animate(lightbox, { opacity: [0, 1], backdropFilter: ['blur(0px)', 'blur(4px)'] }, { duration: 0.3 });
            animate(lightboxImg, { scale: [0.96, 1], opacity: [0.4, 1] }, SPRING.ui);
          }
          btnClose.focus();
        };

        const closeLightbox = () => {
          if (!isOpen) return;
          isOpen = false;
          const done = () => {
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
            lightbox.setAttribute('aria-hidden', 'true');
          };
          if (reduced()) {
            animate(lightbox, { opacity: [1, 0] }, { duration: 0.2 }).then(done);
          } else {
            animate(lightbox, { opacity: [1, 0], backdropFilter: ['blur(4px)', 'blur(0px)'] }, { duration: 0.25 }).then(done);
            animate(lightboxImg, { scale: 0.96, opacity: 0 }, { duration: 0.2 });
          }
          document.body.style.overflow = '';
          originTile?.focus();
          originTile = null;
        };

        const step = (dir: 1 | -1) => {
          show(current + dir);
          if (!reduced()) {
            animate(lightboxImg, { opacity: [0.4, 1], scale: [0.98, 1] }, { duration: 0.25 });
          }
        };

        // Build tiles as real buttons — keyboard reachable
        collected.forEach((item, index) => {
          const parent = item.el.parentElement;
          if (parent && parent.tagName === 'P' && parent.children.length === 1) {
            parent.style.display = 'none';
          } else {
            item.el.style.display = 'none';
          }

          const tile = document.createElement('button');
          tile.type = 'button';
          tile.className = 'aspect-square overflow-hidden rounded-lg cursor-zoom-in group';
          tile.setAttribute(
            'aria-label',
            isKo ? `이미지 크게 보기: ${item.alt}` : `View image: ${item.alt}`,
          );
          const tileImg = document.createElement('img');
          tileImg.src = item.src;
          tileImg.alt = item.alt;
          tileImg.loading = 'lazy';
          tileImg.className = 'w-full h-full object-cover transition-transform duration-300 group-hover:scale-105';
          tile.appendChild(tileImg);
          grid.appendChild(tile);

          tile.addEventListener('click', () => openLightbox(index, tile));
        });

        gallery.classList.remove('hidden');

        lightbox.addEventListener('click', closeLightbox);
        lightboxImg.addEventListener('click', (e) => e.stopPropagation());
        btnClose.addEventListener('click', (e) => {
          e.stopPropagation();
          closeLightbox();
        });
        btnPrev.addEventListener('click', (e) => {
          e.stopPropagation();
          step(-1);
        });
        btnNext.addEventListener('click', (e) => {
          e.stopPropagation();
          step(1);
        });

        document.addEventListener('keydown', (e) => {
          if (!isOpen) return;
          if (e.key === 'Escape') closeLightbox();
          else if (e.key === 'ArrowLeft') step(-1);
          else if (e.key === 'ArrowRight') step(1);
          else if (e.key === 'Tab') {
            // Trap focus across the three lightbox controls
            const controls = [btnClose, btnPrev, btnNext];
            const first = controls[0];
            const last = controls[controls.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });
      });
    }
  </script>
</BaseLayout>
