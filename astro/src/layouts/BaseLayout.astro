---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: Locale;
  heroPage?: boolean;
}

const {
  title,
  description,
  image,
  locale = 'ko',
  heroPage = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <BaseHead title={title} description={description} image={image} locale={locale} />
  </head>
  <body class={`min-h-screen flex flex-col ${heroPage ? 'has-hero' : ''}`}>
    <a href="#main-content" class="skip-link">
      {locale === 'ko' ? '본문으로 건너뛰기' : 'Skip to main content'}
    </a>

    <div id="header-sentinel" class="pointer-events-none absolute left-0 top-0 h-20 w-px" aria-hidden="true"></div>
    <Header locale={locale} />

    {/* Spacer for fixed header on non-hero pages */}
    {!heroPage && <div class="h-16" aria-hidden="true"></div>}

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Progressive enhancement: content stays visible if JavaScript fails. -->
    <script>
      import { inView } from 'motion';
      import { animate } from 'motion/mini';
      import { reduced } from '../scripts/motion';

      const revealEls = document.querySelectorAll<HTMLElement>('.fade-up');

      if (!reduced()) {
        revealEls.forEach((el) => {
          const siblings = Array.from(el.parentElement?.children ?? []).filter(
            (c): c is HTMLElement =>
              c instanceof HTMLElement && c.classList.contains('fade-up'),
          );
          const i = Math.max(0, siblings.indexOf(el));
          const stop = inView(
            el,
            () => {
              el.style.opacity = '0';
              el.style.transform = 'translateY(18px)';
              animate(
                el,
                {
                  opacity: 1,
                  transform: 'translateY(0px)',
                },
                {
                  duration: 0.6,
                  ease: [0.16, 1, 0.3, 1],
                  delay: Math.min(i * 0.06, 0.3),
                },
              );
              stop();
            },
            { margin: '0px 0px -10% 0px' },
          );
        });
      }
    </script>
  </body>
</html>
