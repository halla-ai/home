---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale?: Locale;
  heroPage?: boolean;
}

const {
  title,
  description,
  image,
  locale = 'ko',
  heroPage = false,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <BaseHead title={title} description={description} image={image} locale={locale} />
  </head>
  <body class={`min-h-screen flex flex-col bg-white dark:bg-void dark:text-slate-200 transition-colors duration-200 ${heroPage ? 'has-hero' : ''}`}>
    <a href="#main-content" class="skip-link">
      {locale === 'ko' ? '본문으로 건너뛰기' : 'Skip to main content'}
    </a>

    <Header locale={locale} />

    {/* Spacer for fixed header on non-hero pages */}
    {!heroPage && <div class="h-16" aria-hidden="true"></div>}

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <!-- Film grain texture -->
    <div class="film-grain" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg">
        <filter id="grain">
          <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
        </filter>
        <rect width="100%" height="100%" filter="url(#grain)" />
      </svg>
    </div>

    <!-- Scroll reveal: Motion inView, staggered per sibling group -->
    <script>
      import { inView, animate } from 'motion';
      import { reduced } from '../scripts/motion';

      const revealEls = document.querySelectorAll<HTMLElement>('.fade-up');

      if (reduced()) {
        revealEls.forEach((el) => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      } else {
        revealEls.forEach((el) => {
          const siblings = Array.from(el.parentElement?.children ?? []).filter(
            (c): c is HTMLElement =>
              c instanceof HTMLElement && c.classList.contains('fade-up'),
          );
          const i = Math.max(0, siblings.indexOf(el));
          const stop = inView(
            el,
            () => {
              animate(
                el,
                { opacity: 1, transform: 'translateY(0px)' },
                {
                  duration: 0.6,
                  easing: [0.16, 1, 0.3, 1],
                  delay: Math.min(i * 0.06, 0.3),
                },
              );
              stop();
            },
            { margin: '0px 0px -10% 0px' },
          );
        });
      }
    </script>
  </body>
</html>
