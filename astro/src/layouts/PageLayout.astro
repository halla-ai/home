---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  heroMedia?: {
    src: string;
    alt: string;
    avif?: string;
    webp?: string;
    sizes?: string;
    width?: number;
    height?: number;
    position?: string;
  };
  locale?: Locale;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  description,
  image,
  heroMedia,
  locale = 'ko',
  breadcrumbs,
} = Astro.props;

const homeCrumb = { label: t(locale, 'common.breadcrumb_home'), href: locale === 'en' ? '/en/' : '/' };
const crumbs = breadcrumbs
  ? [homeCrumb, ...breadcrumbs]
  : [homeCrumb, { label: title }];

const heroWidth = heroMedia?.width ?? 1920;
const heroHeight = heroMedia?.height ?? 900;
const heroSizes = heroMedia?.sizes ?? '100vw';
---

<BaseLayout
  title={title}
  description={description}
  image={image ?? heroMedia?.src}
  locale={locale}
  heroPage
>
  <section class="page-hero isolate min-h-[26rem] md:min-h-[31rem]">
    {heroMedia && (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <picture class="block h-full w-full">
          {heroMedia.avif && <source srcset={heroMedia.avif} type="image/avif" sizes={heroSizes} />}
          {heroMedia.webp && <source srcset={heroMedia.webp} type="image/webp" sizes={heroSizes} />}
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            width={heroWidth}
            height={heroHeight}
            sizes={heroSizes}
            class="h-full w-full object-cover opacity-80 dark:opacity-75"
            style={`object-position: ${heroMedia.position ?? 'center'}`}
            loading="eager"
          />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-r from-void/95 via-void/62 to-transparent dark:from-void/95 dark:via-void/65 dark:to-void/5"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-void/90 via-transparent to-void/10"></div>
      </div>
    )}
    <div class="container relative z-10 flex min-h-[26rem] items-end py-12 md:min-h-[31rem] md:py-16">
      <div class="max-w-3xl">
      <Breadcrumb items={crumbs} />
      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {locale === 'en' ? 'Department of Artificial Intelligence' : '제주한라대학교 인공지능학과'}
      </p>
      <h1 class="mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-balance md:text-6xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-slate-200 md:text-lg">
            {description}
          </p>
        )
      }
      <div class="mt-8 h-px w-24 bg-accent" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <div class="container py-14 md:py-20 lg:py-24">
    <slot />
  </div>
</BaseLayout>
