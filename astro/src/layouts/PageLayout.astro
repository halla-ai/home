---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  heroMedia?: {
    src: string;
    alt: string;
    position?: string;
  };
  locale?: Locale;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  description,
  image,
  heroMedia,
  locale = 'ko',
  breadcrumbs,
} = Astro.props;

const homeCrumb = { label: t(locale, 'common.breadcrumb_home'), href: locale === 'en' ? '/en/' : '/' };
const crumbs = breadcrumbs
  ? [homeCrumb, ...breadcrumbs]
  : [homeCrumb, { label: title }];
---

<BaseLayout
  title={title}
  description={description}
  image={image ?? heroMedia?.src}
  locale={locale}
  heroPage
>
  <section class="page-hero isolate min-h-[26rem] md:min-h-[31rem]">
    {heroMedia && (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <img
          src={heroMedia.src}
          alt={heroMedia.alt}
          class="h-full w-full object-cover opacity-55 dark:opacity-45"
          style={`object-position: ${heroMedia.position ?? 'center'}`}
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-void via-void/80 to-void/25 dark:from-void dark:via-void/85 dark:to-void/35"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-void via-transparent to-void/25"></div>
      </div>
    )}
    <div class="container relative z-10 flex min-h-[26rem] items-end py-12 md:min-h-[31rem] md:py-16">
      <div class="max-w-3xl">
      <Breadcrumb items={crumbs} />
      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {locale === 'en' ? 'Department of Artificial Intelligence' : '제주한라대학교 인공지능학과'}
      </p>
      <h1 class="mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-balance md:text-6xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-slate-200 md:text-lg">
            {description}
          </p>
        )
      }
      <div class="mt-8 h-px w-24 bg-accent" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <div class="container py-14 md:py-20 lg:py-24">
    <slot />
  </div>
</BaseLayout>
