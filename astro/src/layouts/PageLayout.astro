---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import type { PageHeroMedia } from '../config/pageHeroes';
import { t, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  heroMedia?: PageHeroMedia;
  locale?: Locale;
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  title,
  description,
  image,
  heroMedia,
  locale = 'ko',
  breadcrumbs,
} = Astro.props;

const homeCrumb = { label: t(locale, 'common.breadcrumb_home'), href: locale === 'en' ? '/en/' : '/' };
const crumbs = breadcrumbs
  ? [homeCrumb, ...breadcrumbs]
  : [homeCrumb, { label: title }];

const heroWidth = heroMedia?.width ?? 1920;
const heroHeight = heroMedia?.height ?? 1080;
const heroSizes = heroMedia?.sizes ?? '100vw';
const heroOverlay = heroMedia?.overlay ?? 'balanced';
---

<BaseLayout
  title={title}
  description={description}
  image={image ?? heroMedia?.src}
  locale={locale}
  heroPage
>
  <section class={`page-hero page-hero--${heroOverlay} isolate min-h-[26rem] md:min-h-[31rem]`}>
    {heroMedia && (
      <div class="absolute inset-0 -z-10" aria-hidden="true">
        <picture class="block h-full w-full">
          {heroMedia.avif && <source srcset={heroMedia.avif} type="image/avif" sizes={heroSizes} />}
          {heroMedia.webp && <source srcset={heroMedia.webp} type="image/webp" sizes={heroSizes} />}
          <img
            src={heroMedia.src}
            alt={heroMedia.alt}
            width={heroWidth}
            height={heroHeight}
            sizes={heroSizes}
            class="h-full w-full object-cover opacity-95 dark:opacity-90"
            style={`object-position: ${heroMedia.position ?? 'center'}`}
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
    )}
    <div class="container relative z-10 flex min-h-[26rem] items-end py-12 md:min-h-[31rem] md:py-16">
      <div class="max-w-3xl">
      <Breadcrumb items={crumbs} />
      <p class="mt-7 text-xs font-semibold uppercase tracking-[0.24em] text-accent">
        {locale === 'en' ? 'Department of Artificial Intelligence' : '제주한라대학교 인공지능학과'}
      </p>
      <h1 class="mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-balance md:text-6xl">
        {title}
      </h1>
      {
        description && (
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-pretty text-slate-200 md:text-lg">
            {description}
          </p>
        )
      }
      <div class="mt-8 h-px w-24 bg-accent" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <div class="container py-14 md:py-20 lg:py-24">
    <slot />
  </div>
</BaseLayout>

<style>
  /* The shared page-hero pseudo-element is overridden per media variant so
   * the title remains readable without hiding the hero image. */
  .page-hero--balanced::after {
    background:
      linear-gradient(104deg, rgb(5 10 18 / 0.84) 0%, rgb(5 10 18 / 0.56) 38%, rgb(5 10 18 / 0.14) 74%, transparent 100%),
      linear-gradient(0deg, rgb(5 10 18 / 0.62) 0%, transparent 48%, rgb(5 10 18 / 0.12) 100%);
  }

  .page-hero--strong::after {
    background:
      linear-gradient(104deg, rgb(5 10 18 / 0.94) 0%, rgb(5 10 18 / 0.7) 44%, rgb(5 10 18 / 0.2) 78%, transparent 100%),
      linear-gradient(0deg, rgb(5 10 18 / 0.7) 0%, transparent 48%, rgb(5 10 18 / 0.14) 100%);
  }

  .page-hero--quiet::after {
    background:
      linear-gradient(104deg, rgb(5 10 18 / 0.68) 0%, rgb(5 10 18 / 0.38) 38%, rgb(5 10 18 / 0.06) 74%, transparent 100%),
      linear-gradient(0deg, rgb(5 10 18 / 0.5) 0%, transparent 48%, rgb(5 10 18 / 0.08) 100%);
  }

  @media (max-width: 767px) {
    .page-hero--balanced::after {
      background: linear-gradient(180deg, rgb(5 10 18 / 0.14) 0%, rgb(5 10 18 / 0.34) 44%, rgb(5 10 18 / 0.82) 100%);
    }

    .page-hero--strong::after {
      background: linear-gradient(180deg, rgb(5 10 18 / 0.24) 0%, rgb(5 10 18 / 0.48) 44%, rgb(5 10 18 / 0.9) 100%);
    }

    .page-hero--quiet::after {
      background: linear-gradient(180deg, rgb(5 10 18 / 0.08) 0%, rgb(5 10 18 / 0.24) 44%, rgb(5 10 18 / 0.72) 100%);
    }
  }
</style>
