---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Pillars from '../components/home/Pillars.astro';
import FeaturedAchievement from '../components/home/FeaturedAchievement.astro';
import Partners from '../components/home/Partners.astro';
import LatestPosts from '../components/home/LatestPosts.astro';
import Testimonials from '../components/home/Testimonials.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { t } from '../i18n/ui';

const locale = 'ko';
---

<BaseLayout
  title={t(locale, 'site.title')}
  description={t(locale, 'site.description')}
  locale={locale}
  heroPage={true}
>
  <Hero locale={locale} />
  <Pillars locale={locale} />
  <FeaturedAchievement locale={locale} />
  <Partners locale={locale} />
  <Testimonials locale={locale} />
  <LatestPosts locale={locale} />
  <FinalCta locale={locale} />
</BaseLayout>
