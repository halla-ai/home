---
import PageLayout from '../layouts/PageLayout.astro';
import { t } from '../i18n/ui';

const locale = 'ko';

const tracks = [
  {
    id: 'ai-core',
    name: 'AI 핵심',
    goal: '인공지능 엔지니어 / 개발자',
    semesters: [
      { sem: '1-1', courses: ['인공지능과사회'] },
      { sem: '1-2', courses: ['인공지능개론', '언어모형과자연어처리'] },
      { sem: '2-1', courses: ['기계학습', '컴퓨터비전', '신호및시스템'] },
      { sem: '2-2', courses: ['패턴인식', '음성인식및합성', '객체인식추적'] },
      { sem: '3-1', courses: ['딥러닝', '알고리즘', '멀티모달생성형AI'] },
      { sem: '3-2', courses: ['딥러닝자연어처리'] },
      { sem: '4-2', courses: ['차세대인공지능'] },
    ],
  },
  {
    id: 'sw-system',
    name: 'SW & 시스템',
    goal: '소프트웨어 & 시스템 전문가',
    semesters: [
      { sem: '1-1', courses: ['정보보안개론', '기초파이썬코딩'] },
      { sem: '1-2', courses: ['서버및네트워크보안'] },
      { sem: '2-1', courses: ['계산과학', '운영체제'] },
      { sem: '2-2', courses: ['AI보안', '데이터구조'] },
      { sem: '3-2', courses: ['클라우드컴퓨팅', '컴퓨터구조'] },
      { sem: '4-1', courses: ['머신러닝시스템'] },
    ],
  },
  {
    id: 'data',
    name: '데이터 분석',
    goal: '데이터 분석 전문가',
    semesters: [
      { sem: '1-1', courses: ['인공지능수학'] },
      { sem: '1-2', courses: ['확률통계의기초', '빅데이터기초및실습'] },
      { sem: '2-1', courses: ['R프로그래밍'] },
      { sem: '3-2', courses: ['지능형시스템'] },
    ],
  },
  {
    id: 'ai-app',
    name: 'AI 응용기술',
    goal: 'AI 로봇 전문가 / 응용기술 개발자',
    semesters: [
      { sem: '2-2', courses: ['로보틱스기초'] },
      { sem: '3-1', courses: ['협동로봇활용'] },
      { sem: '3-2', courses: ['게임프로그래밍', '지능형HCI와UX'] },
      { sem: '4-1', courses: ['3D엔진', '개인화AI신호처리'] },
    ],
  },
  {
    id: 'capstone',
    name: '실무역량',
    goal: '실무역량 강화',
    semesters: [
      { sem: '3-1', courses: ['캡스톤디자인1'] },
      { sem: '3-2', courses: ['캡스톤디자인2'] },
      { sem: '4-1', courses: ['캡스톤디자인3'] },
      { sem: '4-2', courses: ['캡스톤디자인4'] },
    ],
  },
];

const highlights = [
  { title: '단계적 학습 구조', desc: '1-2학년 기초 과목 → 3-4학년 심화 및 응용 과목으로 체계적 진행' },
  { title: '트랙별 체계적 교육', desc: '5개 전문 트랙을 통한 맞춤형 전문가 양성' },
  { title: '실무역량 강화', desc: '3-4학년 캡스톤디자인 1-4 연속 진행 + 산업체 연계 프로젝트' },
  { title: '최신 기술 반영', desc: '멀티모달 생성형 AI, 차세대 AI 등 최신 기술 과목 편성' },
];
---

<PageLayout
  title={t(locale, 'nav.curriculum')}
  description="AI 전문인력 양성을 위한 체계적 교육과정"
  heroMedia={{ src: '/images/curriculum/curriculum.png', alt: '인공지능학과 교육과정과 실습 현장' }}
  locale={locale}
>
  <section class="mb-16">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Learning architecture</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">교육목표</h2>
      <p class="mt-4 leading-relaxed text-muted dark:text-slate-400">
        인공지능학과는 5개 트랙의 체계적 교육을 통해 AI 핵심 기술부터 응용, 시스템, 데이터 분석까지 아우르는 종합적 AI 전문가를 양성합니다.
      </p>
    </div>
    <ol class="mt-8 grid gap-x-10 md:grid-cols-2">
      {tracks.map((track, index) => (
        <li class="flex gap-5 border-t border-border py-5 dark:border-white/[0.1]">
          <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-base font-semibold text-deep dark:text-white">{track.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted dark:text-slate-400">{track.goal}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-y border-border py-10 dark:border-white/[0.1]" aria-labelledby="roadmap-title">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Five tracks</p>
        <h2 id="roadmap-title" class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">교과 로드맵</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted dark:text-slate-400">학기별 과목을 따라가며 각 트랙의 전문성을 단계적으로 쌓습니다.</p>
    </div>
    <div class="space-y-3">
      {tracks.map((track, index) => (
        <section class="border-t border-border py-6 dark:border-white/[0.1]" aria-labelledby={`track-${track.id}`}>
          <header class="grid gap-2 md:grid-cols-[minmax(12rem,0.38fr)_1fr] md:gap-8">
            <div class="flex items-start gap-4">
              <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 id={`track-${track.id}`} class="text-lg font-semibold text-deep dark:text-white">{track.name}</h3>
                <p class="mt-1 text-sm text-muted dark:text-slate-400">{track.goal}</p>
              </div>
            </div>
            <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {track.semesters.map((semester, semesterIndex) => (
                <li class="relative border-l border-accent/30 pl-4 dark:border-accent/40">
                  <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-accent">{semester.sem} semester</p>
                  <ul class="mt-2 space-y-1.5">
                    {semester.courses.map((course) => (
                      <li class="text-sm leading-relaxed text-deep dark:text-slate-200">{course}</li>
                    ))}
                  </ul>
                  {semesterIndex < track.semesters.length - 1 && <span class="absolute -bottom-3 left-[-0.22rem] hidden text-xs text-accent/70 lg:block" aria-hidden="true">→</span>}
                </li>
              ))}
            </ol>
          </header>
        </section>
      ))}
    </div>
  </section>

  <section class="pt-16" aria-labelledby="highlights-title">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Course design</p>
      <h2 id="highlights-title" class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">수업계획</h2>
    </div>
    <ol class="grid gap-x-10 md:grid-cols-2">
      {highlights.map((item, index) => (
        <li class="flex gap-5 border-t border-border py-5 dark:border-white/[0.1]">
          <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-base font-semibold text-deep dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted dark:text-slate-400">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</PageLayout>
