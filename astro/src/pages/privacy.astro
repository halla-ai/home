---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../i18n/ui';

const locale = 'ko';
const pages = await getCollection('pages');
const page = pages.find((p) => p.id === `${locale}/privacy`);
if (!page) throw new Error('Privacy page not found');
const { Content } = await render(page);
---

<PageLayout
  title={t(locale, 'footer.privacy')}
  description="제주한라대학교 인공지능학과 개인정보처리방침"
  locale={locale}
>
  <div class="mx-auto max-w-4xl rounded-[1.5rem] border border-border bg-white/80 px-5 py-8 shadow-sm dark:border-white/[0.08] dark:bg-white/[0.025] sm:px-8 md:px-12 md:py-12">
    <article class="prose max-w-none">
      <Content />
    </article>
  </div>
</PageLayout>
