---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const locale = 'en';
const allProjects = await getCollection('projects');
let projects = allProjects.filter((p) => p.id.startsWith(`${locale}/`));
if (projects.length === 0) {
  projects = allProjects.filter((p) => p.id.startsWith('ko/'));
}
projects = projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PageLayout
  title={t(locale, 'nav.research')}
  description="Key research projects of the Department of AI"
  heroMedia={{ src: '/images/research/research.png', alt: 'Research projects in the Department of Artificial Intelligence' }}
  locale={locale}
>
  <div class="mb-12 max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Research portfolio</p>
    <p class="mt-4 text-lg leading-relaxed text-muted dark:text-slate-300">Students and faculty turn industry problems into AI research and real-world demonstrations.</p>
  </div>

  <div class="grid gap-x-10 gap-y-12 md:grid-cols-2">
    {projects.map((project, index) => {
      const slug = project.id.replace(/^(en|ko)\//, '');
      const tools = project.data.tools
        ? (Array.isArray(project.data.tools) ? project.data.tools : project.data.tools.split(',').map((tool: string) => tool.trim()))
        : [];
      return (
        <article class="group border-t border-border pt-6 dark:border-white/[0.1]">
          <a href={`/en/research/${slug}/`} class="block">
            <div class="flex items-baseline justify-between gap-4">
              <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
              <time class="font-mono text-[11px] tabular-nums text-muted dark:text-slate-500" datetime={project.data.date.toISOString()}>{project.data.date.getFullYear()}</time>
            </div>
            {project.data.image && (
              <div class="mt-5 aspect-[16/10] overflow-hidden rounded-xl bg-stone dark:bg-white/[0.04]">
                <img src={project.data.image} alt={project.data.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
              </div>
            )}
            <div class="mt-5">
              {project.data.subtitle && <p class="text-xs font-semibold uppercase tracking-wider text-accent">{project.data.subtitle}</p>}
              <h2 class="mt-2 text-xl font-bold leading-snug text-deep transition-colors group-hover:text-accent dark:text-white">{project.data.title}</h2>
              <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted dark:text-slate-400">{project.data.summary}</p>
              {tools.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5">
                  {tools.map((tool: string) => <li class="text-xs text-muted before:mr-2 before:text-accent before:content-['/'] dark:text-slate-500">{tool}</li>)}
                </ul>
              )}
            </div>
          </a>
        </article>
      );
    })}
  </div>
</PageLayout>
