---
import PageLayout from '../../../layouts/PageLayout.astro';
import { pageHero } from '../../../config/pageHeroes';
import { getCollection } from 'astro:content';
import { t, tagSlug, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  const locale = 'en';
  const posts = await getCollection('posts');
  let localePosts = posts.filter((p) => p.id.startsWith(`${locale}/`));
  if (localePosts.length === 0) {
    localePosts = posts.filter((p) => p.id.startsWith('ko/'));
  }

  const tags = new Set<string>();
  localePosts.forEach((post) => post.data.tags.forEach((tag: string) => tags.add(tag)));

  const canonicalTags = new Map<string, string>();
  tags.forEach((tag) => {
    const slug = tagSlug(tag);
    const current = canonicalTags.get(slug);
    if (!current || (!/[A-Z]/.test(current) && /[A-Z]/.test(tag))) canonicalTags.set(slug, tag);
  });

  const buildPath = (routeTag: string, label: string) => ({
    params: { tag: routeTag },
    props: {
      tag: label,
      locale,
      posts: localePosts
        .filter((p) => p.data.tags.some((postTag: string) => tagSlug(postTag) === tagSlug(label)))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  });

  const canonicalPaths = [...canonicalTags].map(([slug, label]) => buildPath(slug, label));
  const legacyPaths = [...tags]
    .filter((tag) => tag !== tagSlug(tag))
    .map((tag) => buildPath(tag, tag));

  return [...canonicalPaths, ...legacyPaths];
}

const { tag, locale, posts } = Astro.props;
const typedLocale = locale as Locale;

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<PageLayout
  title={tag}
  description={`Posts tagged with "${tag}"`}
  heroMedia={pageHero('tags', typedLocale)}
  locale={typedLocale}
  breadcrumbs={[{ label: t(typedLocale, 'common.tags'), href: '/en/tags/' }, { label: tag }]}
>
  <div class="grid gap-x-10 gap-y-10 md:grid-cols-2">
    {posts.map((post: any) => {
      const slug = post.id.replace(/^(en|ko)\//, '');
      return (
        <a href={`/en/posts/${slug}/`} class="group block border-t border-border pt-5 dark:border-white/[0.1]">
          {post.data.image && (
            <div class="aspect-[16/9] overflow-hidden rounded-xl bg-stone dark:bg-white/[0.04]">
              <img src={post.data.image} alt={post.data.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
            </div>
          )}
          <div class="mt-5">
            <time class="text-xs font-medium uppercase tracking-wider text-accent/80" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <h3 class="mt-2 text-xl font-bold leading-snug text-deep transition-colors group-hover:text-accent dark:text-white">{post.data.title}</h3>
            {post.data.description && <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-muted dark:text-slate-400">{post.data.description}</p>}
          </div>
        </a>
      );
    })}
  </div>
</PageLayout>
