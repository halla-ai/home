---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';

const locale = 'en';
const allFaculty = await getCollection('faculty');
let faculty = allFaculty.filter((f) => f.id.startsWith(`${locale}/`));
if (faculty.length === 0) {
  faculty = allFaculty.filter((f) => f.id.startsWith('ko/'));
}
faculty = faculty.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title={t(locale, 'nav.faculty')}
  description="Meet the faculty of the Department of AI"
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(faculty.map((m) => ({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": m.data.name_en || m.data.name,
    ...(m.data.name_en ? { "alternateName": m.data.name } : {}),
    "jobTitle": m.data.title,
    "email": m.data.email,
    ...(m.data.phone ? { "telephone": m.data.phone } : {}),
    ...(m.data.photo ? { "image": new URL(m.data.photo, 'https://halla.ai').href } : {}),
    "knowsAbout": m.data.research_areas,
    "affiliation": {
      "@type": "EducationalOrganization",
      "name": "Department of Artificial Intelligence, Cheju Halla University",
      "url": "https://halla.ai"
    },
    ...(m.data.website ? { "url": m.data.website } : {}),
    ...(m.data.scholar || m.data.github || m.data.linkedin ? {
      "sameAs": [m.data.scholar, m.data.github, m.data.linkedin].filter(Boolean)
    } : {})
  })))} />

  <div class="grid gap-x-10 gap-y-12 md:grid-cols-2 xl:grid-cols-3">
    {faculty.map((member, index) => (
      <article class="group border-t border-border pt-6 dark:border-white/[0.1]">
        <div class="flex items-start gap-5">
          <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-stone dark:bg-white/[0.05]">
            <img src={member.data.photo} alt={member.data.name_en || member.data.name} class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
          </div>
          <div class="min-w-0 pt-1">
            <p class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mt-2 text-xl font-bold tracking-tight text-deep dark:text-white">{member.data.name_en || member.data.name}</h2>
            <p class="mt-0.5 text-sm text-muted dark:text-slate-400">{member.data.name}</p>
            {member.data.role && <p class="mt-2 text-sm font-semibold text-accent">{member.data.role}</p>}
            <p class="mt-0.5 text-sm text-muted dark:text-slate-400">{member.data.title}</p>
          </div>
        </div>

        <div class="mt-7 space-y-6">
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Research areas</p>
            <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
              {member.data.research_areas.map((area: string) => (
                <li class="text-sm leading-relaxed text-deep dark:text-slate-200">{area}</li>
              ))}
            </ul>
          </div>
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Education</p>
            <ul class="mt-3 space-y-1">
              {member.data.education.slice(0, 2).map((education: string) => (
                <li class="text-sm leading-relaxed text-muted dark:text-slate-400">{education}</li>
              ))}
            </ul>
          </div>
        </div>

        <nav class="mt-7 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-xs font-medium dark:border-white/[0.1]" aria-label={`${member.data.name_en || member.data.name} links`}>
          <a href={`mailto:${member.data.email}`} class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-slate-400">Email</a>
          {member.data.website && <a href={member.data.website} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-slate-400">Website</a>}
          {member.data.github && <a href={member.data.github} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-slate-400">GitHub</a>}
          {member.data.scholar && <a href={member.data.scholar} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-slate-400">Scholar</a>}
          {member.data.linkedin && <a href={member.data.linkedin} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-slate-400">LinkedIn</a>}
        </nav>
      </article>
    ))}
  </div>
</PageLayout>
