---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { pageHero } from '../../config/pageHeroes';
import { t } from '../../i18n/ui';

const locale = 'en';
const allFaculty = await getCollection('faculty');
let faculty = allFaculty.filter((f) => f.id.startsWith(`${locale}/`));
if (faculty.length === 0) {
  faculty = allFaculty.filter((f) => f.id.startsWith('ko/'));
}
faculty = faculty.sort((a, b) => a.data.order - b.data.order);
const leadership = faculty.filter((member) => Boolean(member.data.role));
const directory = faculty.filter((member) => !member.data.role);
const phoneHref = (phone: string) => `tel:${phone.replace(/[^\d+]/g, '')}`;
---

<PageLayout
  title={t(locale, 'nav.faculty')}
  description="Meet the faculty of the Department of AI"
  heroMedia={pageHero('faculty', locale)}
  locale={locale}
>
  <script type="application/ld+json" set:html={JSON.stringify(faculty.map((m) => ({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": m.data.name_en || m.data.name,
    ...(m.data.name_en ? { "alternateName": m.data.name } : {}),
    "jobTitle": m.data.title,
    "email": m.data.email,
    ...(m.data.phone ? { "telephone": m.data.phone } : {}),
    ...(m.data.photo ? { "image": new URL(m.data.photo, 'https://halla.ai').href } : {}),
    "knowsAbout": m.data.research_areas,
    "affiliation": {
      "@type": "EducationalOrganization",
      "name": "Department of Artificial Intelligence, Cheju Halla University",
      "url": "https://halla.ai"
    },
    ...(m.data.website ? { "url": m.data.website } : {}),
    ...(m.data.scholar || m.data.github || m.data.linkedin ? {
      "sameAs": [m.data.scholar, m.data.github, m.data.linkedin].filter(Boolean)
    } : {})
  })))} />

  <div class="space-y-20 md:space-y-28">
    <section aria-labelledby="leadership-heading">
      <div class="max-w-2xl">
        <h2 id="leadership-heading" class="text-3xl font-bold tracking-tight text-deep dark:text-white md:text-4xl">Faculty leadership</h2>
        <p class="mt-4 text-base leading-relaxed text-muted dark:text-text-soft md:text-lg">Meet the dean and department chair guiding AI education and research.</p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {leadership.map((member) => (
          <article class="card-flat group rounded-2xl p-5 md:p-7">
            <div class="grid gap-6 sm:grid-cols-[11rem_1fr] sm:items-start">
              <div class="overflow-hidden rounded-2xl bg-stone dark:bg-white/[0.05]">
                <img
                  src={member.data.photo}
                  alt={`Portrait of ${member.data.name_en || member.data.name}`}
                  width="240"
                  height="240"
                  class="aspect-square h-auto w-full object-cover transition duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </div>
              <div class="min-w-0">
                <h3 class="text-2xl font-bold tracking-tight text-deep dark:text-white">{member.data.name_en || member.data.name}</h3>
                <p class="mt-1 text-sm text-muted dark:text-text-soft">{member.data.name}</p>
                {member.data.role && <p class="mt-4 text-base font-semibold text-accent dark:text-blue-400">{member.data.role}</p>}
                <p class="mt-1 text-sm font-medium text-muted dark:text-text-soft">{member.data.title}</p>
              </div>
            </div>

            <div class="mt-7 grid gap-6 border-t border-border pt-6 dark:border-white/[0.1]">
              <div>
                <h4 class="text-sm font-semibold text-deep dark:text-white">Specialization</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted dark:text-text-soft">{member.data.specialization}</p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-deep dark:text-white">Research areas</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {member.data.research_areas.map((area: string) => (
                    <li class="rounded-2xl border border-border bg-surface px-3 py-1.5 text-sm leading-relaxed text-deep dark:border-white/[0.1] dark:bg-white/[0.04] dark:text-slate-200">{area}</li>
                  ))}
                </ul>
              </div>
            </div>

            <nav class="mt-7 flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-5 text-sm font-semibold dark:border-white/[0.1]" aria-label={`${member.data.name_en || member.data.name} contact and external links`}>
              <a href={`mailto:${member.data.email}`} class="break-all text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-deep hover:decoration-accent dark:text-blue-400 dark:hover:text-white">{member.data.email}</a>
              {member.data.website && <a href={member.data.website} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">Website</a>}
              {member.data.scholar && <a href={member.data.scholar} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">Google Scholar</a>}
              {member.data.github && <a href={member.data.github} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">GitHub</a>}
              {member.data.linkedin && <a href={member.data.linkedin} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">LinkedIn</a>}
            </nav>

            <details class="faculty-details mt-6 border-t border-border pt-4 dark:border-white/[0.1]">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-xl text-sm font-semibold text-deep transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-white">
                <span>More details</span>
                <i class="faculty-details-icon ph ph-caret-right text-base transition-transform duration-200" aria-hidden="true"></i>
              </summary>
              <div class="mt-5 grid gap-6 sm:grid-cols-2">
                <div>
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Teaching areas</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.teaching_areas.map((area: string) => <li>{area}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Education</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.education.map((education: string) => <li>{education}</li>)}
                  </ul>
                </div>
                <div class="sm:col-span-2">
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Experience</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.experience.map((experience: string) => <li>{experience}</li>)}
                  </ul>
                </div>
                <div class="sm:col-span-2">
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Contact</h4>
                  <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
                    {member.data.phone && (
                      <div>
                        <dt class="text-muted dark:text-text-soft">Phone</dt>
                        <dd class="mt-1 font-medium text-deep dark:text-slate-100"><a href={phoneHref(member.data.phone)} class="underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent">{member.data.phone}</a></dd>
                      </div>
                    )}
                    {member.data.office && (
                      <div>
                        <dt class="text-muted dark:text-text-soft">Office</dt>
                        <dd class="mt-1 font-medium text-deep dark:text-slate-100">{member.data.office}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="directory-heading">
      <div class="max-w-2xl">
        <h2 id="directory-heading" class="text-3xl font-bold tracking-tight text-deep dark:text-white md:text-4xl">Faculty directory</h2>
        <p class="mt-4 text-base leading-relaxed text-muted dark:text-text-soft md:text-lg">Explore each faculty member's specialization and research areas, then open the details for background and contact information.</p>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        {directory.map((member) => (
          <article class="card-flat group rounded-2xl p-5 md:p-6">
            <div class="flex items-start gap-5">
              <div class="h-28 w-28 shrink-0 overflow-hidden rounded-2xl bg-stone dark:bg-white/[0.05]">
                <img
                  src={member.data.photo}
                  alt={`Portrait of ${member.data.name_en || member.data.name}`}
                  width="224"
                  height="224"
                  class="aspect-square h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              </div>
              <div class="min-w-0 pt-1">
                <h3 class="text-xl font-bold tracking-tight text-deep dark:text-white">{member.data.name_en || member.data.name}</h3>
                <p class="mt-1 text-sm text-muted dark:text-text-soft">{member.data.name}</p>
                <p class="mt-3 text-sm font-semibold text-deep dark:text-slate-100">{member.data.title}</p>
              </div>
            </div>

            <div class="mt-6 space-y-5 border-t border-border pt-6 dark:border-white/[0.1]">
              <div>
                <h4 class="text-sm font-semibold text-deep dark:text-white">Specialization</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted dark:text-text-soft">{member.data.specialization}</p>
              </div>
              <div>
                <h4 class="text-sm font-semibold text-deep dark:text-white">Research areas</h4>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {member.data.research_areas.map((area: string) => (
                    <li class="rounded-2xl border border-border bg-surface px-3 py-1.5 text-sm leading-relaxed text-deep dark:border-white/[0.1] dark:bg-white/[0.04] dark:text-slate-200">{area}</li>
                  ))}
                </ul>
              </div>
            </div>

            <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-5 text-sm font-semibold dark:border-white/[0.1]" aria-label={`${member.data.name_en || member.data.name} contact and external links`}>
              <a href={`mailto:${member.data.email}`} class="break-all text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:text-deep hover:decoration-accent dark:text-blue-400 dark:hover:text-white">{member.data.email}</a>
              {member.data.website && <a href={member.data.website} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">Website</a>}
              {member.data.scholar && <a href={member.data.scholar} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">Google Scholar</a>}
              {member.data.github && <a href={member.data.github} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">GitHub</a>}
              {member.data.linkedin && <a href={member.data.linkedin} target="_blank" rel="noopener" class="text-muted underline decoration-border underline-offset-4 transition-colors hover:text-accent hover:decoration-accent dark:text-text-soft">LinkedIn</a>}
            </nav>

            <details class="faculty-details mt-6 border-t border-border pt-4 dark:border-white/[0.1]">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-xl text-sm font-semibold text-deep transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent dark:text-white">
                <span>More details</span>
                <i class="faculty-details-icon ph ph-caret-right text-base transition-transform duration-200" aria-hidden="true"></i>
              </summary>
              <div class="mt-5 grid gap-6 sm:grid-cols-2">
                <div>
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Teaching areas</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.teaching_areas.map((area: string) => <li>{area}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Education</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.education.map((education: string) => <li>{education}</li>)}
                  </ul>
                </div>
                <div class="sm:col-span-2">
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Experience</h4>
                  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted marker:text-accent dark:text-text-soft">
                    {member.data.experience.map((experience: string) => <li>{experience}</li>)}
                  </ul>
                </div>
                <div class="sm:col-span-2">
                  <h4 class="text-sm font-semibold text-deep dark:text-white">Contact</h4>
                  <dl class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
                    {member.data.phone && (
                      <div>
                        <dt class="text-muted dark:text-text-soft">Phone</dt>
                        <dd class="mt-1 font-medium text-deep dark:text-slate-100"><a href={phoneHref(member.data.phone)} class="underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent">{member.data.phone}</a></dd>
                      </div>
                    )}
                    {member.data.office && (
                      <div>
                        <dt class="text-muted dark:text-text-soft">Office</dt>
                        <dd class="mt-1 font-medium text-deep dark:text-slate-100">{member.data.office}</dd>
                      </div>
                    )}
                  </dl>
                </div>
              </div>
            </details>
          </article>
        ))}
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .faculty-details[open] .faculty-details-icon {
    transform: rotate(90deg);
  }
</style>
