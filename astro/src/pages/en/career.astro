---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageHero } from '../../config/pageHeroes';

const locale = 'en';

const partners = [
  {
    name: 'Saltlux',
    field: 'AI Professor, Agentic RAG, LUXIA LLM',
    date: '2024.09',
    period: '5 yrs',
    desc: 'Joint R&D on AI professor systems and intelligent education platforms, RISE industry-academia collaborative project',
    logo: '/images/career/partners/saltlux.png',
  },
  {
    name: 'Dassault Systèmes / eINS S&C',
    field: 'Digital Twin, RISE Innovation Education',
    date: '2024.11',
    period: '1 yr',
    desc: 'Development of industry-linked curriculum in digital transformation, AI, and aerospace; digital twin-based research',
    logo: '/images/career/partners/dassault.png',
  },
  {
    name: 'Pulse9',
    field: 'AI VFX, Eternity Content',
    date: '2024.11',
    period: '2 yrs',
    desc: 'AI-based immersive content education, museum Eternity concert hall construction and operation',
    logo: '/images/career/partners/pulse9.png',
  },
  {
    name: 'Amazon Web Services',
    field: 'Aerospace, AI Education, Cloud',
    date: '2025.07',
    period: '5 yrs',
    desc: 'Jeju regional innovation AI education project support, joint Letter of Support with KAIST and Saltlux',
    logo: '/images/career/partners/aws.png',
  },
  {
    name: 'Diquest',
    field: 'Search/NLP, AI Education Platform',
    date: '2025.04',
    period: '3 yrs',
    desc: 'Building a hybrid cloud-based global AI education platform, developing education data management systems',
    logo: '/images/career/partners/diquest.png',
  },
  {
    name: 'Hanwha Systems',
    field: 'Space Industry, Satellite Communications',
    date: '2025.09',
    period: '5 yrs',
    desc: 'Jeju space industry talent development, satellite communication technology education, RISE project collaboration',
    logo: '/images/career/partners/hanwha.png',
  },
  {
    name: 'Pix4D',
    field: 'Photogrammetry, Digital Twin',
    date: '2025.10',
    period: '-',
    desc: 'Digital twin education center establishment, photogrammetry-based education program operation',
    logo: '/images/career/partners/pix4d.png',
  },
];

const cooperationAreas = [
  { title: 'AI Education Platform', desc: 'Joint development of intelligent education platforms with Saltlux and Diquest; 24/7 AI tutoring powered by Agentic RAG' },
  { title: 'Digital Twin & VFX', desc: 'Digital twin, AI VFX, and immersive content education with Dassault Systèmes, Pulse9, and Pix4D' },
  { title: 'Aerospace & Drones', desc: 'Space industry talent development and drone education programs with AWS, Hanwha Systems, and EHang' },
  { title: 'Internships & Field Training', desc: 'Field training and employment-linked programs at major IT companies including Samsung, LG, and Kakao' },
  { title: 'International Collaboration', desc: 'AI education and research exchange with TIU, ITIC, UIC and other overseas universities; KOICA ODA projects' },
  { title: 'Design Thinking', desc: 'RISE innovation education with Stanford d.school, creative problem-solving education' },
];

const employmentCompanies = [
  { name: 'Samsung', logo: '/images/career/company-samsung.png' },
  { name: 'LG', logo: '/images/career/company-lg.png' },
  { name: 'Kakao', logo: '/images/career/company-kakao.png' },
  { name: 'SKT', logo: '/images/career/company-skt.png' },
  { name: 'NHN', logo: '/images/career/company-nhn.png' },
  { name: 'HMC', logo: '/images/career/company-hmc.png' },
];
---

<PageLayout
  title="Industry-Academia Partnerships"
  description="Developing industry-ready AI professionals through partnerships with leading companies and organizations"
  heroMedia={pageHero('career', locale)}
  locale={locale}
>
  <section class="mb-16 border-y border-border py-6 dark:border-white/[0.1]" aria-label="Partnership overview">
    <dl class="grid gap-6 sm:grid-cols-3 sm:gap-0">
      <div class="sm:border-r sm:border-border sm:pr-6 dark:sm:border-white/[0.1]">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">Industry partners</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">14+</dd>
      </div>
      <div class="sm:border-r sm:border-border sm:px-6 dark:sm:border-white/[0.1]">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">Partner countries</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">5+</dd>
      </div>
      <div class="sm:pl-6">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">RISE research funding</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">₩1.7B+</dd>
      </div>
    </dl>
  </section>

  <section class="mb-16">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Industry network</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Key industry partners</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted dark:text-slate-400">We design learning and research in the field with industry partners, connecting project experience to career paths.</p>
    </div>
    <div class="grid gap-x-10 md:grid-cols-2">
      {partners.map((partner, index) => (
        <article class="group border-t border-border py-6 dark:border-white/[0.1]">
          <div class="flex items-start gap-5">
            <span class="pt-1 font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                <div>
                  <h3 class="text-lg font-semibold text-deep transition-colors group-hover:text-accent dark:text-white">{partner.name}</h3>
                  <p class="mt-1 text-xs font-medium text-accent">{partner.field}</p>
                </div>
                <p class="font-mono text-[11px] tabular-nums text-muted dark:text-slate-500">{partner.date} · {partner.period}</p>
              </div>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted dark:text-slate-400">{partner.desc}</p>
              <img src={partner.logo} alt={partner.name} class="mt-5 h-7 max-w-28 object-contain object-left opacity-70 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0 dark:brightness-0 dark:invert dark:opacity-60 dark:group-hover:opacity-90" loading="lazy" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 border-y border-border py-10 dark:border-white/[0.1]">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Ways we collaborate</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Areas of cooperation</h2>
    </div>
    <div class="grid gap-x-10 md:grid-cols-2">
      {cooperationAreas.map((area, index) => (
        <article class="border-t border-border py-5 dark:border-white/[0.1]">
          <div class="flex items-start gap-5">
            <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-base font-semibold text-deep dark:text-white">{area.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted dark:text-slate-400">{area.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Career destinations</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Major employers</h2>
    </div>
    <ul class="grid grid-cols-2 border-t border-border dark:border-white/[0.1] sm:grid-cols-3 md:grid-cols-6">
      {employmentCompanies.map((company) => (
        <li class="flex min-h-24 items-center justify-center border-b border-r border-border px-4 py-5 last:border-r-0 dark:border-white/[0.1]">
          <img src={company.logo} alt={company.name} class="h-8 w-auto object-contain opacity-70 grayscale dark:brightness-150" loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
