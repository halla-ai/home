---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageHero } from '../../config/pageHeroes';
import { t } from '../../i18n/ui';

const locale = 'en';

const tracks = [
  {
    id: 'ai-core',
    name: 'AI Core',
    goal: 'AI Engineer / Developer',
    semesters: [
      { sem: '1-1', courses: ['AI & Society'] },
      { sem: '1-2', courses: ['Intro to AI', 'Language Models & NLP'] },
      { sem: '2-1', courses: ['Machine Learning', 'Computer Vision', 'Signals & Systems'] },
      { sem: '2-2', courses: ['Pattern Recognition', 'Speech Recognition', 'Object Tracking'] },
      { sem: '3-1', courses: ['Deep Learning', 'Algorithms', 'Multimodal Generative AI'] },
      { sem: '3-2', courses: ['DL for NLP'] },
      { sem: '4-2', courses: ['Next-Gen AI'] },
    ],
  },
  {
    id: 'sw-system',
    name: 'SW & Systems',
    goal: 'Software & Systems Specialist',
    semesters: [
      { sem: '1-1', courses: ['Info Security', 'Python Coding'] },
      { sem: '1-2', courses: ['Server & Network Security'] },
      { sem: '2-1', courses: ['Computational Science', 'OS'] },
      { sem: '2-2', courses: ['AI Security', 'Data Structures'] },
      { sem: '3-2', courses: ['Cloud Computing', 'Computer Architecture'] },
      { sem: '4-1', courses: ['ML Systems'] },
    ],
  },
  {
    id: 'data',
    name: 'Data Analysis',
    goal: 'Data Analysis Specialist',
    semesters: [
      { sem: '1-1', courses: ['AI Mathematics'] },
      { sem: '1-2', courses: ['Probability & Statistics', 'Big Data Fundamentals'] },
      { sem: '2-1', courses: ['R Programming'] },
      { sem: '3-2', courses: ['Intelligent Systems'] },
    ],
  },
  {
    id: 'ai-app',
    name: 'AI Applications',
    goal: 'AI Robotics / Applied Tech Developer',
    semesters: [
      { sem: '2-2', courses: ['Robotics Fundamentals'] },
      { sem: '3-1', courses: ['Collaborative Robots'] },
      { sem: '3-2', courses: ['Game Programming', 'Intelligent HCI & UX'] },
      { sem: '4-1', courses: ['3D Engine', 'Personalized AI Signal Processing'] },
    ],
  },
  {
    id: 'capstone',
    name: 'Capstone',
    goal: 'Practical Skills',
    semesters: [
      { sem: '3-1', courses: ['Capstone Design 1'] },
      { sem: '3-2', courses: ['Capstone Design 2'] },
      { sem: '4-1', courses: ['Capstone Design 3'] },
      { sem: '4-2', courses: ['Capstone Design 4'] },
    ],
  },
];

const highlights = [
  { title: 'Progressive learning', desc: 'Foundation courses in years 1-2, advanced and applied courses in years 3-4' },
  { title: 'Five specialized tracks', desc: 'Tailored professional development through specialized learning paths' },
  { title: 'Hands-on projects', desc: 'Four semesters of Capstone Design plus industry partnership projects' },
  { title: 'Current technologies', desc: 'Multimodal Generative AI, Next-Gen AI, and the latest industry trends' },
];
---

<PageLayout
  title={t(locale, 'nav.curriculum')}
  description="Systematic curriculum for AI professional development"
  heroMedia={pageHero('curriculum', locale)}
  locale={locale}
>
  <section class="mb-16">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Learning architecture</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Education objectives</h2>
      <p class="mt-4 leading-relaxed text-muted dark:text-slate-400">
        Our department trains comprehensive AI professionals through five specialized tracks, covering core AI technology, applications, systems, and data analysis.
      </p>
    </div>
    <ol class="mt-8 grid gap-x-10 md:grid-cols-2">
      {tracks.map((track, index) => (
        <li class="flex gap-5 border-t border-border py-5 dark:border-white/[0.1]">
          <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-base font-semibold text-deep dark:text-white">{track.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted dark:text-slate-400">{track.goal}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="border-y border-border py-10 dark:border-white/[0.1]" aria-labelledby="roadmap-title">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Five tracks</p>
        <h2 id="roadmap-title" class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Curriculum roadmap</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted dark:text-slate-400">Follow each semester to build the depth and practical skills of your chosen track.</p>
    </div>
    <div class="space-y-3">
      {tracks.map((track, index) => (
        <section class="border-t border-border py-6 dark:border-white/[0.1]" aria-labelledby={`track-${track.id}`}>
          <header class="grid gap-2 md:grid-cols-[minmax(12rem,0.38fr)_1fr] md:gap-8">
            <div class="flex items-start gap-4">
              <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 id={`track-${track.id}`} class="text-lg font-semibold text-deep dark:text-white">{track.name}</h3>
                <p class="mt-1 text-sm text-muted dark:text-slate-400">{track.goal}</p>
              </div>
            </div>
            <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {track.semesters.map((semester, semesterIndex) => (
                <li class="relative border-l border-accent/30 pl-4 dark:border-accent/40">
                  <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-accent">{semester.sem} semester</p>
                  <ul class="mt-2 space-y-1.5">
                    {semester.courses.map((course) => (
                      <li class="text-sm leading-relaxed text-deep dark:text-slate-200">{course}</li>
                    ))}
                  </ul>
                  {semesterIndex < track.semesters.length - 1 && <span class="absolute -bottom-3 left-[-0.22rem] hidden text-xs text-accent/70 lg:block" aria-hidden="true">→</span>}
                </li>
              ))}
            </ol>
          </header>
        </section>
      ))}
    </div>
  </section>

  <section class="pt-16" aria-labelledby="highlights-title">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Course design</p>
      <h2 id="highlights-title" class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">Curriculum highlights</h2>
    </div>
    <ol class="grid gap-x-10 md:grid-cols-2">
      {highlights.map((item, index) => (
        <li class="flex gap-5 border-t border-border py-5 dark:border-white/[0.1]">
          <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-base font-semibold text-deep dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted dark:text-slate-400">{item.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</PageLayout>
