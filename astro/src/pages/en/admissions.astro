---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageHero } from '../../config/pageHeroes';
import { getCollection, render } from 'astro:content';
import { t } from '../../i18n/ui';

const locale = 'en';
const pages = await getCollection('pages');
const page = pages.find((p) => p.id === `${locale}/admissions`) || pages.find((p) => p.id === 'ko/admissions');
if (!page) throw new Error('Admissions page not found');
const { Content } = await render(page);
---

<PageLayout
  title={t(locale, 'nav.admissions')}
  description={page.data.description || ''}
  heroMedia={pageHero('admissions', locale)}
  locale={locale}
>
  <div class="mx-auto max-w-4xl rounded-[1.5rem] border border-border bg-white/80 px-5 py-8 shadow-sm dark:border-white/[0.08] dark:bg-white/[0.025] sm:px-8 md:px-12 md:py-12">
    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
  </div>
</PageLayout>
