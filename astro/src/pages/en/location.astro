---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageHero } from '../../config/pageHeroes';
import { getCollection, render } from 'astro:content';
import { t } from '../../i18n/ui';

const locale = 'en';
const pages = await getCollection('pages');
const page = pages.find((p) => p.id === `${locale}/location`) || pages.find((p) => p.id === 'ko/location');
if (!page) throw new Error('Location page not found');
const { Content } = await render(page);
---

<PageLayout
  title={t(locale, 'nav.location')}
  description="Cheju Halla University Campus Guide"
  heroMedia={pageHero('location', locale)}
  locale={locale}
>
  <div class="mx-auto max-w-5xl rounded-[1.5rem] border border-border bg-white/80 px-5 py-8 shadow-sm dark:border-white/[0.08] dark:bg-white/[0.025] sm:px-8 md:px-12 md:py-12">
    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
  </div>
</PageLayout>

<style>
  iframe {
    width: 100%;
    max-width: 100%;
    min-height: min(32rem, 70vw);
    border: 1px solid var(--color-border) !important;
    border-radius: 1rem;
  }
</style>
