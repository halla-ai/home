---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import { t } from '../i18n/ui';

const locale = 'ko';
const pages = await getCollection('pages');
const page = pages.find((p) => p.id === `${locale}/tips`);
if (!page) throw new Error('Tips page not found');
const { Content } = await render(page);
---

<PageLayout
  title={t(locale, 'nav.tips')}
  description={page.data.description || ''}
  heroMedia={{ src: '/images/tips/Course_Registration_Manual/1.Course_Registration_Manual.jpg', alt: '수강 신청 매뉴얼 화면' }}
  locale={locale}
>
  <div class="mx-auto max-w-5xl rounded-[1.5rem] border border-border bg-white/80 px-5 py-8 shadow-sm dark:border-white/[0.08] dark:bg-white/[0.025] sm:px-8 md:px-12 md:py-12">
    <article class="prose prose-lg max-w-none">
      <Content />
    </article>
  </div>
</PageLayout>
