---
import PageLayout from '../../layouts/PageLayout.astro';
import { pageHero } from '../../config/pageHeroes';
import { getCollection } from 'astro:content';
import { t, tagSlug, tagUrl } from '../../i18n/ui';

const locale = 'ko';
const allPosts = await getCollection('posts');
const localePosts = allPosts.filter((p) => p.id.startsWith(`${locale}/`));

const tagCounts = new Map<string, { label: string; count: number }>();
localePosts.forEach((post) => {
  post.data.tags.forEach((tag: string) => {
    const slug = tagSlug(tag);
    const current = tagCounts.get(slug);
    tagCounts.set(slug, {
      label: current && (/[A-Z]/.test(current.label) || !/[A-Z]/.test(tag)) ? current.label : tag,
      count: (current?.count || 0) + 1,
    });
  });
});

const sortedTags = [...tagCounts.values()].sort((a, b) => b.count - a.count);
---

<PageLayout
  title={t(locale, 'common.tags')}
  description="주제별 포스트 탐색"
  heroMedia={pageHero('tags', locale)}
  locale={locale}
>
  <div class="grid gap-x-10 md:grid-cols-2">
    {sortedTags.map(({ label, count }, index) => (
      <a
        href={tagUrl('ko', label)}
        class="group flex items-baseline justify-between gap-6 border-t border-border py-5 transition-colors hover:border-accent dark:border-white/[0.1]"
      >
        <span class="flex min-w-0 items-baseline gap-4">
          <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
          <span class="truncate text-lg font-semibold text-deep transition-colors group-hover:text-accent dark:text-white">{label}</span>
        </span>
        <span class="shrink-0 text-sm tabular-nums text-muted dark:text-slate-500">{count}개 포스트</span>
      </a>
    ))}
  </div>
</PageLayout>
