---
import PageLayout from '../layouts/PageLayout.astro';

const locale = 'ko';

const partners = [
  {
    name: '솔트룩스',
    field: 'AI Professor, Agentic RAG, LUXIA LLM',
    date: '2024.09',
    period: '5년',
    desc: 'AI 교수 시스템, 지능형 교육 플랫폼 공동 연구개발 및 RISE 산학공동기술개발과제 수행',
    logo: '/images/career/partners/saltlux.png',
  },
  {
    name: '다쏘시스템 / 아인스에스엔씨',
    field: '디지털트윈, RISE 혁신교육',
    date: '2024.11',
    period: '1년',
    desc: '디지털전환·AI·우주항공 분야 산학연계 교육과정 개발 및 디지털트윈 기반 연구',
    logo: '/images/career/partners/dassault.png',
  },
  {
    name: '펄스나인',
    field: 'AI VFX, 이터니티 콘텐츠',
    date: '2024.11',
    period: '2년',
    desc: 'AI 기반 실감형 콘텐츠 교육, 박물관 이터니티 공연장 구축 및 운영',
    logo: '/images/career/partners/pulse9.png',
  },
  {
    name: 'Amazon Web Services',
    field: '우주항공, AI 교육, 클라우드',
    date: '2025.07',
    period: '5년',
    desc: '제주 지역혁신 AI 교육 프로젝트 지원, KAIST·솔트룩스와 공동 Letter of Support',
    logo: '/images/career/partners/aws.png',
  },
  {
    name: '다이퀘스트',
    field: '검색/NLP, AI 교육 플랫폼',
    date: '2025.04',
    period: '3년',
    desc: '하이브리드 클라우드 기반 글로벌 AI 교육 플랫폼 구축, 교육 데이터 관리 체계 개발',
    logo: '/images/career/partners/diquest.png',
  },
  {
    name: '한화시스템',
    field: '우주산업, 위성통신',
    date: '2025.09',
    period: '5년',
    desc: '제주 우주산업 인재양성, 위성통신 기술 교육, RISE 사업 연계 협력',
    logo: '/images/career/partners/hanwha.png',
  },
  {
    name: 'Pix4D',
    field: '포토그래메트리, 디지털트윈',
    date: '2025.10',
    period: '-',
    desc: '디지털트윈 교육센터 구축, 포토그래메트리 기반 교육 프로그램 운영',
    logo: '/images/career/partners/pix4d.png',
  },
];

const cooperationAreas = [
  { title: 'AI 교육 플랫폼', desc: '솔트룩스·다이퀘스트와 지능형 교육 플랫폼 공동 개발, Agentic RAG 기반 24시간 AI 튜터' },
  { title: '디지털트윈 & VFX', desc: '다쏘시스템·펄스나인·Pix4D와 디지털트윈, AI VFX 실감형 콘텐츠 교육' },
  { title: '우주항공 & 드론', desc: 'AWS·한화시스템·EHang과 우주산업 인재양성, 드론 교육 프로그램' },
  { title: '현장실습 & 인턴십', desc: '삼성·LG·카카오 등 주요 IT 기업 현장실습 및 취업연계 프로그램' },
  { title: '국제 협력', desc: '우즈벡 TIU·ITIC·UIC 등 해외 대학과 AI 교육·연구 교류, KOICA ODA 사업' },
  { title: '디자인씽킹', desc: 'Stanford d.school과 RISE 혁신교육 연계, 창의적 문제해결 교육' },
];

const employmentCompanies = [
  { name: 'Samsung', logo: '/images/career/company-samsung.png' },
  { name: 'LG', logo: '/images/career/company-lg.png' },
  { name: 'Kakao', logo: '/images/career/company-kakao.png' },
  { name: 'SKT', logo: '/images/career/company-skt.png' },
  { name: 'NHN', logo: '/images/career/company-nhn.png' },
  { name: 'HMC', logo: '/images/career/company-hmc.png' },
];
---

<PageLayout
  title="산학협력"
  description="기업·기관과의 산학협력을 통해 현장 중심의 AI 전문가를 양성합니다"
  heroMedia={{ src: '/images/career/career.png', alt: '인공지능학과 산학협력 현장', position: 'center 42%' }}
  locale={locale}
>
  <section class="mb-16 border-y border-border py-6 dark:border-white/[0.1]" aria-label="산학협력 현황">
    <dl class="grid gap-6 sm:grid-cols-3 sm:gap-0">
      <div class="sm:border-r sm:border-border sm:pr-6 dark:sm:border-white/[0.1]">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">산학협력 파트너</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">14+</dd>
      </div>
      <div class="sm:border-r sm:border-border sm:px-6 dark:sm:border-white/[0.1]">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">해외 협력국</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">5+</dd>
      </div>
      <div class="sm:pl-6">
        <dt class="text-xs font-medium text-muted dark:text-slate-500">RISE 연구비</dt>
        <dd class="mt-2 text-3xl font-bold tracking-tight text-accent">17억+</dd>
      </div>
    </dl>
  </section>

  <section class="mb-16">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Industry network</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">주요 산학협력 파트너</h2>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-muted dark:text-slate-400">교육과 연구의 현장을 기업과 함께 설계하고, 프로젝트 경험을 진로로 연결합니다.</p>
    </div>
    <div class="grid gap-x-10 md:grid-cols-2">
      {partners.map((partner, index) => (
        <article class="group border-t border-border py-6 dark:border-white/[0.1]">
          <div class="flex items-start gap-5">
            <span class="pt-1 font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
                <div>
                  <h3 class="text-lg font-semibold text-deep transition-colors group-hover:text-accent dark:text-white">{partner.name}</h3>
                  <p class="mt-1 text-xs font-medium text-accent">{partner.field}</p>
                </div>
                <p class="font-mono text-[11px] tabular-nums text-muted dark:text-slate-500">{partner.date} · {partner.period}</p>
              </div>
              <p class="mt-3 max-w-lg text-sm leading-relaxed text-muted dark:text-slate-400">{partner.desc}</p>
              <img src={partner.logo} alt={partner.name} class="mt-5 h-7 max-w-28 object-contain object-left opacity-70 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0 dark:brightness-0 dark:invert dark:opacity-60 dark:group-hover:opacity-90" loading="lazy" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 border-y border-border py-10 dark:border-white/[0.1]">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Ways we collaborate</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">협력 분야</h2>
    </div>
    <div class="grid gap-x-10 md:grid-cols-2">
      {cooperationAreas.map((area, index) => (
        <article class="border-t border-border py-5 dark:border-white/[0.1]">
          <div class="flex items-start gap-5">
            <span class="font-mono text-xs tabular-nums text-accent/70">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-base font-semibold text-deep dark:text-white">{area.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted dark:text-slate-400">{area.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section>
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Career destinations</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-deep dark:text-white">주요 취업처</h2>
    </div>
    <ul class="grid grid-cols-2 border-t border-border dark:border-white/[0.1] sm:grid-cols-3 md:grid-cols-6">
      {employmentCompanies.map((company) => (
        <li class="flex min-h-24 items-center justify-center border-b border-r border-border px-4 py-5 last:border-r-0 dark:border-white/[0.1]">
          <img src={company.logo} alt={company.name} class="h-8 w-auto object-contain opacity-70 grayscale dark:brightness-150" loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
